as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c41" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="&lt;b style='font-size:12.5px'&gt;K1/K2 (kayan nokta)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;E: FP sonucu yazılmaz, buyruğun kaydına ertelenir&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;W: k2_uygula() çevrim başında MR ve LVF/LUF yazar&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;öncelik: E &gt; toplayıcı K2 &gt; çarpıcı K2&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="52" y="524" width="420" height="66" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b style='font-size:12.5px'&gt;D2 kuralı ve dallanma&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;D2 işi buyruk D2'den ilerlerken bir kez yapılır&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;dal kararı D2'de: 3 gecikme yuvası atılmaz&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;MSTOP D2'de algılanır (Tablo 10-19)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="488" y="524" width="420" height="66" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b style='font-size:12.5px'&gt;dur_exe (interlock)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;E'nin okuduğu MR ∩ W'nin K2 hedefi ≠ ∅&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;→ F1…E bir çevrim bekler, W'ye balon&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;yalnız okuma durdurur&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="52" y="600" width="420" height="66" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b style='font-size:12.5px'&gt;dur_r1 (bellek çakışması)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;W bir bloğa yazar, R1 aynı bloktan okur&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;(L1, L2, C2M) → F1…R1 bekler, R2'ye balon&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;zincirlenir; dur_exe baskın&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="488" y="600" width="420" height="66" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b style='font-size:12.5px'&gt;trace.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;çevrim başına bir satır&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;E buyruğu, MR, MSTF, yazma&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="36" y="696" width="168" height="70" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b style='font-size:12.5px'&gt;compare_trace.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;ilk ayrışmayı bildirir&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;0 aynı · 1 fark · 2 yapılamadı&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="216" y="696" width="168" height="70" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b style='font-size:12.5px'&gt;lint.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;gecikme yuvası · yaz-oku&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;MAR gölge gecikmesi&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="396" y="696" width="168" height="70" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b style='font-size:12.5px'&gt;casm2hex.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;program → .hex&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;LSW alt adreste&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="576" y="696" width="168" height="70" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b style='font-size:12.5px'&gt;lut_uret.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;kestirim tablosu&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;768 × 8 bit&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="756" y="696" width="168" height="70" as="geometry"/></mxCell><mxCell id="c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.095;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="&lt;b style='font-size:15px'&gt;ORTAK SÖZLEŞMELER VE DOĞRULAMA&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;align=left;verticalAlign=bottom;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="808" width="920" height="182" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b style='font-size:13px'&gt;Çevrim izi karşılaştırması&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;golden.trace ↔ rtl.trace, satır satır&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;alu_kabul_1: 122 çevrim, 13 dur_exe&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;23 boru hattı test programı&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="36" y="838" width="348" height="106" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b style='font-size:13px'&gt;ALU vektör testi&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;beklenen = ops_*&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;289.648 vektör&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;0 fark&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="396" y="838" width="168" height="106" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b style='font-size:13px'&gt;Program&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;.hex → RTL L3&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;iki taraf aynı&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;kelimeleri koşar&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="576" y="838" width="168" height="106" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b style='font-size:13px'&gt;Kestirim tablosu&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;estimate_lut.hex&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;Python == RTL&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="756" y="838" width="168" height="106" as="geometry"/></mxCell><mxCell id="c65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.24;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c54" target="c61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.76;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c55" target="c61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c57" target="c63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c58" target="c64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c62"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="956" y="154"/><mxPoint x="956" y="794"/><mxPoint x="480" y="794"/></Array></mxGeometry></mxCell><mxCell id="c70" value="&lt;b style='font-size:15px'&gt;ALU&lt;/b&gt;&lt;span style='font-size:12px'&gt;&amp;nbsp;&amp;nbsp;SystemVerilog · CLA_ALU/ALU.sv · 49 buyruk · 1.830 satır&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="1014" width="920" height="718" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b style='font-size:13px'&gt;Veri girişleri: a · b · c · d&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;32 bit; MR, genişletilmiş anlık&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;ya da bellek verisi (üst modül koyar)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="36" y="1050" width="300" height="84" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b style='font-size:13px'&gt;Kontrol birimi → 17 kontrol girişi (E kademesinde geçerli)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;topla/carpma_cntrl: hedef MR, RND32, valid, çıkarma · tamsayi 3 bit · kestirme 1 bit&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;karsilastirma 7 bit {işlem, CNDF} · donusum 5 bit · mstf_in (MNEGF32 koşulu)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="352" y="1050" width="572" height="84" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b style='font-size:13px'&gt;mux_1 … mux_10&lt;/b&gt;&lt;span style='font-size:11.5px'&gt;&amp;nbsp;&amp;nbsp;her birimin her girişi a, b, c, d'den seçilir; işlenen yerleşimi değişirse yalnız mux değerleri değişir&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="36" y="1150" width="888" height="40" as="geometry"/></mxCell><mxCell id="c74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.19;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c71" target="c73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.72;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c72" target="c73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c76" value="&lt;b style='font-size:15px'&gt;fpu_carpma&lt;/b&gt;&lt;span style='font-size:12px'&gt;&amp;nbsp;&amp;nbsp;iki kademe&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="36" y="1206" width="290" height="408" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b style='font-size:15px'&gt;fpu_toplama&lt;/b&gt;&lt;span style='font-size:12px'&gt;&amp;nbsp;&amp;nbsp;iki kademe&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="342" y="1206" width="290" height="408" as="geometry"/></mxCell><mxCell id="c78" value="&lt;b style='font-size:15px'&gt;Kombinasyonel&lt;/b&gt;&lt;span style='font-size:12px'&gt;&amp;nbsp;&amp;nbsp;sonuç E'de&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="648" y="1206" width="276" height="408" as="geometry"/></mxCell><mxCell id="c79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entry