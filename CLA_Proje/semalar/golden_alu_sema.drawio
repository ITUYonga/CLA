" height="74" as="geometry"/></mxCell><mxCell id="c84" value="&lt;b style='font-size:12px'&gt;K yazmacı&lt;/b&gt;&lt;span style='font-size:10.5px'&gt;&amp;nbsp;saat kenarı · valid · hedef MR · RND32&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="52" y="1390" width="258" height="36" as="geometry"/></mxCell><mxCell id="c85" value="&lt;b style='font-size:12.5px'&gt;carp_k2 · K2 (W çevrimi)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;en üst bit 1 ise sağa kaydır, üs + 1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;24 bit + G, R, S&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="52" y="1440" width="258" height="58" as="geometry"/></mxCell><mxCell id="c86" value="&lt;b style='font-size:12.5px'&gt;pack.sv (ortak)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;özel: NaN 0x7FC00000 · ±∞ · +0&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;taşma → LVF · alttan taşma → +0, LUF&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;RND32: 0 kes · 1 en yakın çift&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;bayraklar valid ile VE'lenir&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="52" y="1512" width="258" height="86" as="geometry"/></mxCell><mxCell id="c87" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c82" target="c83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c