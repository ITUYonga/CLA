t;&lt;td style='padding:0 10px'&gt;32&lt;/td&gt;&lt;td&gt;anlık → d muxu (01), sonuç muxu (5)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;imm_shift&lt;/td&gt;&lt;td style='padding:0 10px'&gt;32&lt;/td&gt;&lt;td&gt;anlık → d muxu (10)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;imm_lo&lt;/td&gt;&lt;td style='padding:0 10px'&gt;32&lt;/td&gt;&lt;td&gt;anlık → sonuç muxu (6)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;mar_imm, mar_mr&lt;/td&gt;&lt;td style='padding:0 10px'&gt;16 + 16&lt;/td&gt;&lt;td&gt;anlık → MAR yükleme&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;okunan&lt;/td&gt;&lt;td style='padding:0 10px'&gt;32&lt;/td&gt;&lt;td&gt;R2/E → d muxu, sonuç muxu, MSTF E, MAR, W'ye veri&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="1380" width="852" height="289" as="geometry"/></mxCell><mxCell id="c114" value="&lt;b style='font-size:13px'&gt;Bağlantı listesi 2/3&lt;/b&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;ad&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:0 10px'&gt;&lt;b&gt;bit&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;kaynak → hedef&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;d&lt;/td&gt;&lt;td style='padding:0 10px'&gt;32&lt;/td&gt;&lt;td&gt;d muxu → ALU&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;alu&lt;/td&gt;&lt;td style='padding:0 10px'&gt;42&lt;/td&gt;&lt;td&gt;R2/E → ALU kontrol sözcükleri&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ALU kontrolü&lt;/td&gt;&lt;td style='padding:0 10px'&gt;26 + 20 + 5&lt;/td&gt;&lt;td&gt;ALU kontrol → ALU (sözcükler, mux, mstf_in)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RND32&lt;/td&gt;&lt;td style='padding:0 10px'&gt;1&lt;/td&gt;&lt;td&gt;MSTF → ALU kontrol&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;E sonuçları&lt;/td&gt;&lt;td style='padding:0 10px'&gt;4 × 32&lt;/td&gt;&lt;td&gt;ALU → sonuç muxu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;mstf_out[3:2], zf/nf_karş&lt;/td&gt;&lt;td style='padding:0 10px'&gt;2 + 2&lt;/td&gt;&lt;td&gt;ALU → ZF/NF&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;lvf/luf_kestirme&lt;/td&gt;&lt;td style='padding:0 10px'&gt;2&lt;/td&gt;&lt;td&gt;ALU → MSTF E&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;kosul&lt;/td&gt;&lt;td style='padding:0 10px'&gt;4&lt;/td&gt;&lt;td&gt;R2/E → koşul&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;kosul_tuttu&lt;/td&gt;&lt;td style='padding:0 10px'&gt;1&lt;/td&gt;&lt;td&gt;koşul → E izinleri, MSTF E (TF)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;e_veri1&lt;/td&gt;&lt;td style='padding:0 10px'&gt;32&lt;/td&gt;&lt;td&gt;sonuç muxu → MR yazma E1, ZF/NF&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;E1, E2&lt;/td&gt;&lt;td style='padding:0 10px'&gt;2 × (1 + 2 + 32)&lt;/td&gt;&lt;td&gt;sonuç muxu, E izinleri → MR yazma&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;zf_e, nf_e, zn_yaz&lt;/td&gt;&lt;td style='padding:0 10px'&gt;3&lt;/td&gt;&lt;td&gt;ZF/NF → MSTF E&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;yeni MSTF + izinler&lt;/td&gt;&lt;td style='padding:0 10px'&gt;19 + 7&lt;/td&gt;&lt;td&gt;MSTF E → MSTF dosyası&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;mar_veri, hedef, yaz&lt;/td&gt;&lt;td style='padding:0 10px'&gt;16 + 1 + 1&lt;/td&gt;&lt;td&gt;MAR yükleme → MAR&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="888" y="1380" width="852" height="289" as="geometry"/></mxCell><mxCell id="c115" value="&lt;b style='font-size:13px'&gt;Bağlantı listesi 3/3&lt;/b&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;ad&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:0 10px'&gt;&lt;b&gt;bit&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;kaynak → hedef&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MAR0, MAR1&lt;/td&gt;&lt;td style='padding:0 10px'&gt;2 × 16&lt;/td&gt;&lt;td&gt;MAR → W'ye veri (1)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;yaz_veri, yaz_adr, bellek_yaz&lt;/td&gt;&lt;td style='padding:0 10px'&gt;32 + 16 + 2&lt;/td&gt;&lt;td&gt;W'ye veri → E/W&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;E/W çıkışı&lt;/td&gt;&lt;td style='padding:0 10px'&gt;1 + 2 + 16 + 32&lt;/td&gt;&lt;td&gt;E/W → RAM yazma, iz&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;K2T, K2C&lt;/td&gt;&lt;td style='padding:0 10px'&gt;2 × (1 + 2 + 32)&lt;/td&gt;&lt;td&gt;ALU (W) → MR yazma&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;lvf/luf K2&lt;/td&gt;&lt;td style='padding:0 10px'&gt;4&lt;/td&gt;&lt;td&gt;ALU (W) → MSTF W, görünen MSTF&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;valid + hedef K2&lt;/td&gt;&lt;td style='padding:0 10px'&gt;2 × 3&lt;/td&gt;&lt;td&gt;ALU (W) → dur_exe&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;okunan_mr, geçerli&lt;/td&gt;&lt;td style='padding:0 10px'&gt;4 + 1&lt;/td&gt;&lt;td&gt;R2/E → dur_exe&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;dur_exe&lt;/td&gt;&lt;td style='padding:0 10px'&gt;1&lt;/td&gt;&lt;td&gt;dur_exe → ALU kontrol, E izinleri, E/W, boru hattı&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;görünen MSTF&lt;/td&gt;&lt;td style='padding:0 10px'&gt;5 / 32&lt;/td&gt;&lt;td&gt;görünen → koşul, ALU, W'ye veri (2), D2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MR yazma&lt;/td&gt;&lt;td style='padding:0 10px'&gt;4 × (1 + 32)&lt;/td&gt;&lt;td&gt;MR yazma → MR dosyası&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LVF/LUF W&lt;/td&gt;&lt;td style='padding:0 10px'&gt;2 + 1&lt;/td&gt;&lt;td&gt;MSTF W → MSTF dosyası&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RAM portu&lt;/td&gt;&lt;td style='padding:0 10px'&gt;10 + 2 + 32&lt;/td&gt;&lt;td&gt;RAM yazma → L1 / L2 / C2M&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1756" y="1380" width="852" height="289" as="geometry"/></mxCell><mxCell id="c116" value="&lt;b style='font-size:13px'&gt;Notlar&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;veri_mr (kontrol_t): VERI_MR'de belleğe yazılan MR'nin ve MAR_MR_ARTI_IMM'de MAR'a eklenen MR'nin numarası · RAM dout, rd_en = 0 iken tutulmalı · ALU rst portu aktif düşük&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="1687" width="2596" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>