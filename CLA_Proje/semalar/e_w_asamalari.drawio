<mxfile host="drawio" type="device"><diagram id="e-w" name="E ve W asamalari"><mxGraphModel dx="1000" dy="1000" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2640" pageHeight="1767" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b style='font-size:22px'&gt;CLA Üst Modül: E ve W Aşamaları&lt;/b&gt;&lt;span style='font-size:14px'&gt;&amp;nbsp;&amp;nbsp;bloklar, bağlantı genişlikleri (bit) ve yazmaç içerikleri · golden model zamanlamasına göre öneri&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="2000" height="30" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="14" height="14" as="geometry"/></mxCell><mxCell id="c13" value="&lt;span style='font-size:12px'&gt;boru hattı yazmacı (FF)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="37" width="180" height="20" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#cdb6e6;strokeColor=#5b3f86;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="225" y="40" width="14" height="14" as="geometry"/></mxCell><mxCell id="c15" value="&lt;span style='font-size:12px'&gt;mimari durum (FF)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="245" y="37" width="180" height="20" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="430" y="40" width="14" height="14" as="geometry"/></mxCell><mxCell id="c17" value="&lt;span style='font-size:12px'&gt;kombinasyonel blok&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="450" y="37" width="180" height="20" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e9f5e4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="635" y="40" width="14" height="14" as="geometry"/></mxCell><mxCell id="c19" value="&lt;span style='font-size:12px'&gt;ALU (CLA_ALU)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="655" y="37" width="180" height="20" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="840" y="40" width="14" height="14" as="geometry"/></mxCell><mxCell id="c21" value="&lt;span style='font-size:12px'&gt;anlık genişletme&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="860" y="37" width="180" height="20" as="geometry"/></mxCell><mxCell id="c22" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1045" y="40" width="14" height="14" as="geometry"/></mxCell><mxCell id="c23" value="&lt;span style='font-size:12px'&gt;isimli bağlantı (uzak tel)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1065" y="37" width="180" height="20" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1250" y="40" width="14" height="14" as="geometry"/></mxCell><mxCell id="c25" value="&lt;span style='font-size:12px'&gt;kural / dikkat&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1270" y="37" width="180" height="20" as="geometry"/></mxCell><mxCell id="c26" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="1458" y="41" width="18" height="12" as="geometry"/></mxCell><mxCell id="c27" value="&lt;span style='font-size:12px'&gt;saat kenarı · ok üstündeki sayı = bit&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1480" y="37" width="300" height="20" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style='font-size:13px'&gt;MR0 – MR3 · 4 × 32 = 128 FF&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;her MRx: en_x 1 + veri_x 32 (MR yazma biriminden) · çıkış 4 × 32 → MR okuma&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#cdb6e6;strokeColor=#5b3f86;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="500" height="66" as="geometry"/></mxCell><mxCell id="c29" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="1041" y="123" width="18" height="12" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b style='font-size:13px'&gt;R2/E · 217 FF&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&lt;b&gt;geçerli 1&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;pc 12 *&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;kelime 32 *&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;ea 16&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;m 16&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;shift 6&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;okunan 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&lt;b&gt;kontrol_t 102&lt;/b&gt;:&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;kosul 4 · bellek_oku 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;alu 42&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;a_mr 2 · b_mr 2 · c_mr 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;d_kaynak 2 · d_mr 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;okunan_mr 4&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;exe_yaz 1 · exe_hedef 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;exe_kaynak 3 · exe_kaynak_mr 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;exe_yaz_2 1 · exe_hedef_2 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;exe_kaynak_mr_2 2 · exe_kosullu 1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;mar_yukle 1 · mar_hedef 1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;mar_kaynak 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;zn_kaynak 3 · lvf_luf_kestirme 1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;tf_yaz 1 · meallow_yaz 1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;meallow_deger 1 · msetflg 1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;mstf_yukle 1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;bellek_yaz 2 · yaz_veri 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;yaz_adres_arti2 1 · veri_mr 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;D2 alanları 6 (E'de kullanılmaz)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;* yalnız iz için&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;yükleme: dur_exe → tut&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;aksi halde R1/R2 + dout&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="250" height="1010" as="geometry"/></mxCell><mxCell id="c31" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="136" y="1177" width="18" height="12" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b style='font-size:15px'&gt;E aşaması&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#9e9e9e;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="296" y="180" width="1230" height="1010" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b style='font-size:13px'&gt;E/W · 63 FF&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&lt;b&gt;geçerli 1&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;pc 12 *&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;bellek_yaz 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;yaz_adr 16&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;yaz_veri 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;yükleme:&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;dur_exe → geçerli ← 0&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;aksi halde E'den&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;ALU K yazmaçları&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;bu kenarda (aşağıda)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1550" y="180" width="210" height="1010" as="geometry"/></mxCell><mxCell id="c34" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="1646" y="1177" width="18" height="12" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b style='font-size:15px'&gt;W aşaması&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#9e9e9e;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1786" y="180" width="830" height="1010" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b style='font-size:12px'&gt;d kaynağı muxu&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;4:1 × 32 · seçim d_kaynak 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;00 D_MR: MR[d_mr]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;01 D_IMM_HI: imm_hi&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;10 D_SHIFT: imm_shift&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;11 D_BELLEK: okunan&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ d 32 (ALU)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="320" y="220" width="170" height="210" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b style='font-size:12px'&gt;Anlık genişletme birimi&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;girdi: m 16 · shift 6&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MR[exe_hedef][31:16] 16 · MR[veri_mr][15:0] 16&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;imm_hi = {m, 16'h0} → 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;imm_shift = {26'b0, shift} → 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;imm_lo = {MR[exe_hedef][31:16], m} → 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;mar_imm = m → 16&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;mar_mr = MR[veri_mr][15:0] + m → 16&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="545" y="220" width="260" height="210" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b style='font-size:12px'&gt;MR okuma muxları&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;8 × (4:1 × 32), seçimler R2/E'den&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;a ← MR[a_mr] · b ← MR[b_mr]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;c ← MR[c_mr] · MR[d_mr] → d muxu&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MR[exe_kaynak_mr] → sonuç muxu&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MR[exe_kaynak_mr_2] = e_veri2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MR[veri_mr] → anlık, W'ye veri&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MR[exe_hedef] → anlık&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="860" y="220" width="235" height="210" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b style='font-size:12px'&gt;ALU kontrol sözcükleri&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;v = geçerli ∧ ¬dur_exe ∧ ¬dondur&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;topla_cntrl 5 = {hedef 2, RND32, kullan ∧ v, çıkarma}&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;carpma_cntrl 5 = {hedef 2, RND32, kullan ∧ v, 0}&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;tamsayi_cntrl 3 · kestirme_cntrl 1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;karsilastirma_cntrl 7 = {islem 3, cndf 4}&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;donusum_cntrl 5 = {RND32, islem 4}&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;mux_1 … mux_10: 10 × 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;mstf_in 5 = görünen {TF ZF NF LUF LVF}&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1145" y="220" width="365" height="210" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b style='font-size:12px'&gt;Koşul değerlendirici&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;girdi: kosul 4 (R2/E)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;görünen {TF ZF NF LUF LVF} 5&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ kosul_tuttu 1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;kullanılan: exe_kosullu, MTESTTF&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;(MNEGF32'nin koşulu ALU içinde)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="320" y="460" width="250" height="140" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b style='font-size:12px'&gt;E yazma izinleri&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;v = geçerli ∧ ¬dur_exe ∧ ¬dondur&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;e_yaz1 = v ∧ exe_yaz ∧&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;  (¬exe_kosullu ∨ kosul_tuttu)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;e_yaz2 = v ∧ exe_yaz_2 ∧&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;  (¬exe_kosullu ∨ kosul_tuttu)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;mar_yaz = v ∧ mar_yukle&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;zn_yaz, tf, meallow, msetflg,&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;mstf_yukle izinleri de ∧ v&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="320" y="630" width="250" height="230" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b style='font-size:15px'&gt;ALU (CLA_ALU/ALU.sv)&lt;/b&gt;&lt;span style='font-size:12px'&gt;&amp;nbsp;&amp;nbsp;clk · rst (aktif düşük) · K1 E'de, K yazmacı E/W kenarında, K2 W'de&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#e9f5e4;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="590" y="460" width="1680" height="400" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b style='font-size:12px'&gt;giriş muxları&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;mux_1 … mux_10&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;her biri 4:1 × 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;a b c d → birim girişleri&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;1, 2 → toplayıcı&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;3, 4 → çarpıcı&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;5, 6 → tamsayı&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;7 → kestirim&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;8, 9 → karşılaştırma&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;10 → dönüşüm&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="605" y="500" width="170" height="340" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b style='font-size:12px'&gt;tamsayi_islem · 3 bit&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ result_tamsayi 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ mstf_out 5 (ZF NF: [3:2])&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="795" y="500" width="235" height="76" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b style='font-size:12px'&gt;fpu_kestirme · 1 bit&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ result_kestirme 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ lvf_, luf_kestirme 1 + 1&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="795" y="586" width="235" height="76" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b style='font-size:12px'&gt;fpu_karsilastirma · 7 + mstf_in 5&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ result_karsilastirma 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ zf_, nf_karsilastirma 1 + 1&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="795" y="672" width="235" height="82" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b style='font-size:12px'&gt;fpu_donusum · 5 bit&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ result_donusum 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;(bayrak üretmez)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="795" y="764" width="235" height="76" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b style='font-size:12px'&gt;fpu_toplama · K1 (E)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;clasify × 2 → topla_k1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;çıkarmada 2. işaret çevrilir&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;büyük işlenen işaret ve üssü verir&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;küçük anlamlı sağa (≤ 26 bit)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ 70 bit (K yazmacına)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1050" y="500" width="290" height="160" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b style='font-size:12px'&gt;fpu_carpma · K1 (E)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;clasify × 2 → carp_k1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;işaret XOR · üs a + b − 127 (10 bit)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;24 × 24 → 48 bit çarpım&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ 65 bit (K yazmacına)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1050" y="680" width="290" height="160" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b style='font-size:13px'&gt;K yazmacı (topla) 70&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;valid 1 · hedef 2 · rnd 1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;işaret 1 · üs 8&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;anlamlı a 27&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;anlamlı b 27&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;cik 1 · kod 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;izinsiz, her kenarda&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1560" y="500" width="190" height="160" as="geometry"/></mxCell><mxCell id="c51" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="1646" y="647" width="18" height="12" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b style='font-size:13px'&gt;K yazmacı (çarp) 65&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;valid 1 · hedef 2 · rnd 1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;işaret 1 · üs 10&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;çarpım 48&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;kod 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;izinsiz, her kenarda&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1560" y="680" width="190" height="160" as="geometry"/></mxCell><mxCell id="c53" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="1646" y="827" width="18" height="12" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b style='font-size:12px'&gt;topla_k2 + pack · K2 (W)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;topla / çıkar · normalleştir · yuvarla (RND32) · paketle&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ result_topla 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ lvf_topla 1 · luf_topla 1 (∧ valid)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ valid_topla 1 · hedef_mr_out_topla 2&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1790" y="500" width="450" height="160" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b style='font-size:12px'&gt;carp_k2 + pack · K2 (W)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;normalleştir · yuvarla (RND32) · paketle&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ result_carp 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ lvf_carp 1 · luf_carp 1 (∧ valid)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ valid_carp 1 · hedef_mr_out_carp 2&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1790" y="680" width="450" height="160" as="geometry"/></mxCell><mxCell id="c56" value="70" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=10.5;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c48" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="65" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=10.5;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c49" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="70" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=10.5;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c50" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="65" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=10.5;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c52" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="&lt;b style='font-size:12px'&gt;MR yazma birimi (4 port)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;E1: e_yaz1 1 · exe_hedef 2 · e_veri1 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;E2: e_yaz2 1 · exe_hedef_2 2 · e_veri2 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;K2T: valid_topla 1 · hedef 2 · result_topla 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;K2C: valid_carp 1 · hedef 2 · result_carp 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;her MRx: en_x = herhangi bir port x'e yazıyor&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;veri_x öncelik: E1/E2 &gt; K2T &gt; K2C&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;dondur → bütün en_x = 0&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ 4 × (en 1 + veri 32) → MR dosyası&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1800" y="220" width="400" height="210" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b style='font-size:12px'&gt;Öncelikler ve kenar durumları&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MR: E &gt; toplayıcı K2 &gt; çarpıcı K2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MSTF: E güncellemesi &gt; K2 LVF/LUF&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;  (golden: K2 çevrim başında, E sonra)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MAR: D2 artışı &gt; E yüklemesi (aynı MAR)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;dur_exe: E yazmaz, W yazar, E/W ← balon&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;dondur: E ve W hiçbir şey yazmaz&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MMACF32 hedef MR3 = MRd ise toplama kalır&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2220" y="220" width="380" height="210" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b style='font-size:12px'&gt;dur_exe birimi&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;girdi: valid + hedef K2 2 × 3&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;k2_maske 4 = (v_t ? 1 &lt;&lt; hedef_t : 0)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;   | (v_c ? 1 &lt;&lt; hedef_c : 0)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;dur_exe = R2/E.geçerli ∧&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;   |(okunan_mr 4 ∧ k2_maske 4)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ dur_exe 1 (kombinasyonel)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2340" y="460" width="260" height="190" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b style='font-size:12px'&gt;Görünen MSTF&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;girdi: MSTF 19 · lvf/luf K2 4&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;LVF' = LVF ∨ lvf_topla ∨ lvf_carp&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;LUF' = LUF ∨ luf_topla ∨ luf_carp&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ görünen 5 (mstf_in, koşul)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ görünen 32 (VERI_MSTF)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ D2 dal kararı&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2340" y="670" width="260" height="190" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b style='font-size:12px'&gt;E sonuç muxu&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;exe_kaynak 3 → 8:1 × 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;0 result_tamsayi · 1 result_kestirme&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;2 result_karsilastirma&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;3 result_donusum · 4 okunan&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;5 imm_hi · 6 imm_lo&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;7 MR[exe_kaynak_mr]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ e_veri1 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;e_veri2 32 = MR[exe_kaynak_mr_2]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;E1, E2 → MR yazma birimi&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="320" y="900" width="250" height="250" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b style='font-size:12px'&gt;ZF/NF birimi&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;girdi: e_veri1 32 · zn_kaynak 3&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;0 YOK&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;1 TAMSAYI: mstf_out[3:2]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;2 KARŞILAŞTIRMA: zf/nf_karş&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;3 YAZILAN_FLOAT:&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;  ZF = (e_veri1[30:23] = 0)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;  NF = e_veri1[31] ∧ ¬ZF&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;4 YAZILAN_TAMSAYI:&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;  ZF = (e_veri1 = 0), NF = [31]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ zf_e 1 · nf_e 1 · zn_yaz 1&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="590" y="900" width="250" height="250" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b style='font-size:12px'&gt;MSTF, E güncellemesi&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;girdi: zf_e · nf_e · zn_yaz 3&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;ZF, NF ← zf_e, nf_e (zn_yaz)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;TF ← kosul_tuttu (tf_yaz)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MEALLOW ← meallow_deger (meallow_yaz)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MSETFLG: m = {FLAG 8, VALUE 8}&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;  FLAG bit 0 1 2 3 6 7 →&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;  LVF LUF NF ZF TF RND32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;yükleme: okunan ∧ 0x00FFFA4F,&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;  MEALLOW korunur&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;LVF/LUF |= kestirim (lvf_luf_kestirme)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="860" y="900" width="290" height="250" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b style='font-size:12px'&gt;MAR yükleme&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;mar_kaynak 2:&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;0 IMM: mar_imm 16&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;1 MR+IMM: mar_mr 16&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;2 BELLEK: okunan[15:0]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ mar_veri 16&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ mar_hedef 1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ mar_yaz 1&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1170" y="900" width="170" height="250" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b style='font-size:12px'&gt;W'ye veri, adres&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;yaz_veri 2:&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;0 MR[veri_mr] 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;1 {16'h0, MAR[mar_hedef]}&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;2 görünen MSTF 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;3 okunan 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ yaz_veri 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;yaz_adres_arti2:&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;ea + 2 : ea → 16&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;bellek_yaz 2 aynen&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ E/W: 32 + 16 + 2&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1360" y="900" width="160" height="250" as="geometry"/></mxCell><mxCell id="c69" value="&lt;b style='font-size:12px'&gt;MSTF, W güncellemesi&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;LVF |= lvf_topla ∨ lvf_carp&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;LUF |= luf_topla ∨ luf_carp&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;(pack çıkışları zaten ∧ valid)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;aynı çevrimde E de yazıyorsa&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;E kazanır&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;→ MSTF dosyası (2 bit + izin)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1800" y="900" width="260" height="250" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b style='font-size:12px'&gt;RAM yazma (W sonu)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;girdi E/W: geçerli 1 · bellek_yaz 2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;yaz_adr 16 · yaz_veri 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;blok: L1 0x8800 · L2 0x8C00 · C2M 0x1480&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;adres = yaz_adr − taban&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;(L1/L2: 10 bit · C2M: 7 bit)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;32 bitte bit 0 = 0&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;wr_en 2 = geçerli ? bellek_yaz : 00&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;din 32 = yaz_veri&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;W bloğu → dur_r1 (R1 tarafı)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2080" y="900" width="270" height="250" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b style='font-size:12px'&gt;İz çıkışı (tezgâh)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;her çevrim:&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;exe_pc 12, exe_op 32 ← R2/E&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MPC 12&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MR0–MR3 4 × 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MAR0, MAR1 2 × 16&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MSTF 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;wr_addr 16 · wr_data 32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;wr_w 2 ← E/W&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;(dur_exe'de E satırı&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;tekrarlanır)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2370" y="900" width="230" height="250" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b style='font-size:13px'&gt;MSTF dosyası · 19 FF&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;LVF LUF NF ZF TF RND32 MEALLOW (7) + RPC 12&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;yazan: E (mse) · W (LVF/LUF) · D2 (RPC)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;çıkış: 19 → görünen MSTF · RND32 1 → ALU kontrol&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#cdb6e6;strokeColor=#5b3f86;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="600" y="1220" width="450" height="100" as="geometry"/></mxCell><mxCell id="c73" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="816" y="1307" width="18" height="12" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b style='font-size:13px'&gt;MAR0, MAR1 · 2 × 16 = 32 FF&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;E: mar_yaz 1 · mar_hedef 1 · mar_veri 16&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;D2: += m (aynı MAR'da öncelikli)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;çıkış 2 × 16&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#cdb6e6;strokeColor=#5b3f86;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1100" y="1220" width="300" height="100" as="geometry"/></mxCell><mxCell id="c75" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="1241" y="1307" width="18" height="12" as="geometry"/></mxCell><mxCell id="c76" value="&lt;b style='font-size:12.5px'&gt;Veri RAM'leri&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;L1, L2 BRAM (1K × 16, blok başına 1 port)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;C2M mesaj RAM (128 × 16, köprüde)&lt;/span&gt;&l