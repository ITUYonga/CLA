;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c33" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c36" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c41" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c42" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c45" target="c47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="&lt;b style='font-size:11.5px'&gt;sonraki getir_pc&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;+2 (sıradaki)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;dal hedefi ← D2&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;RPC ← D2 (MRCNDD)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MVECT[no] ← görev başı&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="320" y="132" width="134" height="116" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b style='font-size:11.5px'&gt;getir_izin = 0&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;→ F1/F2 ← balon&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;(görev yokken getirme yok)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="320" y="258" width="134" height="70" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b style='font-size:11.5px'&gt;kelime&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;= L3 dout&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;(BRAM çıkışı)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="614" y="152" width="104" height="70" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b style='font-size:11.5px'&gt;cla_decoder&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;kelime → op, alan&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;gecersiz&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;kip_gecersiz&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;tamamen komb.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="878" y="152" width="134" height="96" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b style='font-size:11.5px'&gt;cla_ctrl_gen&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;op, alan → kontrol_t&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1180" y="130" width="254" height="50" as="geometry"/></mxCell><mxCell id="c69" value="&lt;b style='font-size:11.5px'&gt;etkin adres&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;kip 0000: m · 0001: MAR0 · 0010: MAR1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;D2 sonunda MARx += m&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1180" y="188" width="254" height="66" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b style='font-size:11.5px'&gt;dal kararı&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;koşul × görünen MSTF&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MBCNDD, MCCNDD: hedef = pc + m&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MCCNDD: RPC ← pc + 8&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MRCNDD: hedef = RPC&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1180" y="262" width="254" height="98" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b style='font-size:11.5px'&gt;görev denetçisine&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MSTOP · gecersiz · MPC ← pc&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1180" y="368" width="254" height="50" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b style='font-size:11.5px'&gt;D2 işi bir kez&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;yalnız D2 ilerlerken yapılır:&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;¬dur_exe ∧ ¬dur_r1 (golden M5)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1180" y="426" width="254" height="64" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b style='font-size:11.5px'&gt;blok ve adres&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;L1 · L2 · C2M · M2C seçimi&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;adres = ea − taban&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;32 bitte bit 0 = 0&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1602" y="130" width="164" height="84" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b style='font-size:11.5px'&gt;okuma izni&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;rd_en = okur ∧ geçerli&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;∧ ¬dur_exe ∧ ¬dur_r1&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1602" y="222" width="164" height="66" as="geometry"/></mxCell><mxCell id="c75" value="&lt;b style='font-size:11.5px'&gt;port seçimi&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;W yazıyorsa W adresi&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;(aynı blok: dur_r1)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1602" y="296" width="164" height="66" as="geometry"/></mxCell><mxCell id="c76" value="&lt;b style='font-size:11.5px'&gt;okunan&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;= dout&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;16 bitte üst 0&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1934" y="152" width="104" height="70" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b style='font-size:11.5px'&gt;işlenenler&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;a, b, c ← MR[a/b/c_mr] · d ← d muxu&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="2214" y="130" width="284" height="52" as="geometry"/></mxCell><mxCell id="c78" value="&lt;b style='font-size:11.5px'&gt;anlık genişletme&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;{m, 16'h0} · {26'b0, shift} → d muxu&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;{MR[exe_hedef][31:16], m} (MMOVXI) → MR&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MR[veri_mr][15:0] + m · m → MAR&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="2214" y="188" width="284" height="74" as="geometry"/></mxCell><mxCell id="c79" value="&lt;b style='font-size:11.5px'&gt;ALU, E kısmı&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;tamsayı · kestirim · karş. · dönüşüm · K1&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="2214" y="268" width="284" height="44" as="geometry"/></mxCell><mxCell id="c80" value="&lt;b style='font-size:11.5px'&gt;koşul&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;kosul × görünen MSTF (kosullu, MTESTTF)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="2214" y="318" width="284" height="44" as="geometry"/></mxCell><mxCell id="c81" value="&lt;b style='font-size:11.5px'&gt;E sonunda yazılır&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MR: exe_hedef, exe_hedef_2 · MAR: mar_yukle&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MSTF: ZF/NF, TF, MEALLOW, MSETFLG, yükleme&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="2214" y="368" width="284" height="66" as="geometry"/></mxCell><mxCell id="c82" value="&lt;b style='font-size:11.5px'&gt;W'ye giden&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;yaz_veri: MR[veri_mr] · MAR · görünen MSTF · okunan&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;yaz_adr: ea ya da ea + 2 (MMOVD32)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="2214" y="440" width="284" height="52" as="geometry"/></mxCell><mxCell id="c83" value="&lt;b style='font-size:11.5px'&gt;ALU K2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;topla → MR[topla_hedef]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;çarp → MR[carp_hedef]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;LVF/LUF → MSTF&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="2666" y="130" width="194" height="82" as="geometry"/></mxCell><mxCell id="c84" value="&lt;b style='font-size:11.5px'&gt;RAM yazma&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;W sonunda: wr_en = bellek_yaz&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;adres, veri E/W'den&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="2666" y="220" width="194" height="66" as="geometry"/></mxCell><mxCell id="c85" value="&lt;b style='font-size:11.5px'&gt;görünen MSTF&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;= MSTF ∨ K2'nin LVF/LUF'u&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;→ D2 dal, E koşulu,&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;MMOV32 mem32, MSTF&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="2666" y="294" width="194" height="82" as="geometry"/></mxCell><mxCell id="c86" value="&lt;b style='font-size:12px'&gt;L3 program BRAM&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;2K × 32 (4K × 16)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;adres F1'de verilir,&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;kenarda BRAM'e girer,&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;kelime F2'de çıkar&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;en = ¬tut (bekleme)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="352" y="396" width="334" height="128" as="geometry"/></mxCell><mxCell id="c87" value="&lt;b style='font-size:12px'&gt;L1 · L2 veri BRAM&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;blok başına 1 port (1K × 16)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;adres R1'de, dout R2'de&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;W yazması aynı porttan&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;rd_en = 0 iken dout&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;TUTULMALI (şu an 0'lanıyor)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;C2M, M2C: köprüdeki RAM'ler&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d