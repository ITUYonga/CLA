<mxfile host="drawio" type="device"><diagram id="ekip" name="Kontrol birimi, yazmaclar ve bellek"><mxGraphModel dx="1000" dy="1900" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1790" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b style='font-size:20px'&gt;CLA Kontrol Birimi, Yazmaçlar ve Bellek&lt;/b&gt;&lt;span style='font-size:13px'&gt;&amp;nbsp;&amp;nbsp;modüller, boru hattındaki yerleri ve bağlantıları&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="760" height="34" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="14" height="14" as="geometry"/></mxCell><mxCell id="c13" value="&lt;span style='font-size:12px'&gt;kontrol birimi&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="45" width="150" height="20" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="192" y="48" width="14" height="14" as="geometry"/></mxCell><mxCell id="c15" value="&lt;span style='font-size:12px'&gt;durum modülleri&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="212" y="45" width="150" height="20" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="364" y="48" width="14" height="14" as="geometry"/></mxCell><mxCell id="c17" value="&lt;span style='font-size:12px'&gt;ALU&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="384" y="45" width="150" height="20" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="536" y="48" width="14" height="14" as="geometry"/></mxCell><mxCell id="c19" value="&lt;span style='font-size:12px'&gt;üst modül (yazılacak)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="556" y="45" width="150" height="20" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="708" y="48" width="14" height="14" as="geometry"/></mxCell><mxCell id="c21" value="&lt;span style='font-size:12px'&gt;golden karşılaştırması&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="728" y="45" width="150" height="20" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style='font-size:13px'&gt;CPU (ya da köprü)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MVECT1–8 ve MIER yazar&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MIFRC ile görev ister&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MIFR · MIRUN okur&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;görev sonunda PIE kesmesi alır&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="200" height="176" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style='font-size:13px'&gt;cla_ctrl_regs&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MIFR · MIOVF · MIER · MIRUN (8 bit)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;CPU adres 0–6: MICLR, MICLROVF, MIFRC&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;çevre tetiği: bayrak kuruluysa MIOVF&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;bekleyen = MIFR ∧ MIER&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;içinde ayrıca task_start_req (boşsa hemen)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="248" y="80" width="286" height="176" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style='font-size:15px'&gt;cla_gorev_denetci&lt;/b&gt;&lt;span style='font-size:12px'&gt;&amp;nbsp;&amp;nbsp;yalnız karar verir&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="562" y="80" width="378" height="262" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;BOŞTA&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="578" y="116" width="96" height="34" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;HAKEM1&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="700" y="116" width="96" height="34" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;HAKEM2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;gorev_basla&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="822" y="116" width="104" height="34" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;CALIŞIYOR&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;getir_izin&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="822" y="182" width="104" height="40" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;DONDU&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;dondur&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="578" y="182" width="96" height="40" as="geometry"/></mxCell><mxCell id="c30" value="bekleyen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="MSTOP D2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="748" y="194"/></Array></mxGeometry></mxCell><mxCell id="c34" value="geçersiz" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="&lt;span style='font-size:10.5px'&gt;öncelik: en küçük numaralı bekleyen görev&lt;br&gt;MSTOP D2'de n: MIRUN temizlenir, PIE, F1 F2 D1 silinir&lt;br&gt;n+1, n+2 hakem · n+3 yeni görevin F1'i (golden ile aynı)&lt;br&gt;reset: her durumdan BOŞTA, tumu_temizle, PIE yok&lt;br&gt;çıkış: gorev_basla/no/bitti · pie_kesme · on_temizle · dondur&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="578" y="236" width="352" height="100" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b style='font-size:13px'&gt;cla_mvect_regs&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;8 × 16 bit · target_pc_out = MVECT[görev]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;golden: alt 12 bit (MPC 12 bit)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="248" y="278" width="286" height="64" as="geometry"/></mxCell><mxCell id="c37" value="yaz / oku" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="MVECT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="310"/></Array></mxGeometry></mxCell><mxCell id="c39" value="bekleyen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="gorev_basla · no · bitti" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.62;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="&lt;b style='font-size:15px'&gt;Boru hattı&lt;/b&gt;&lt;span style='font-size:12px'&gt;&amp;nbsp;&amp;nbsp;üst modül ve kademe yazmaçları henüz yazılmadı&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;align=left;verticalAlign=bottom;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="368" width="920" height="196" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b style='font-size:14px'&gt;F1&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;getirme adresi&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;getir_izin&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;ilk adres MVECT&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="36" y="402" width="104" height="90" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b style='font-size:14px'&gt;F2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;L3 program RAM&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;(bu dosyalarda yok)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="148" y="402" width="104" height="90" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b style='font-size:14px'&gt;D1&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;cla_decoder&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;op · alan&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;gecersiz · kip_gec.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="260" y="402" width="104" height="90" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b style='font-size:14px'&gt;D2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;cla_ctrl_gen → paket&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;adres · MAR += m&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;dal · MSTOP&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="372" y="402" width="104" height="90" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b style='font-size:14px'&gt;R1&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;adres → RAM&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;dur_r1: aynı blok&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="484" y="402" width="104" height="90" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b style='font-size:14px'&gt;R2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;RAM dout&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;1 çevrim gecikme&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="596" y="402" width="104" height="90" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b style='font-size:14px'&gt;E&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;ALU · MR/MAR/MSTF&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;dur_exe&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;FP K1&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="708" y="402" width="104" height="90" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b style='font-size:14px'&gt;W&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;RAM yazma&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;FP K2 → MR&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;LVF/LUF&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="820" y="402" width="104" height="90" as="geometry"/></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c45" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c46" target="c47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c48" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="&lt;span style='font-size:11.5px'&gt;&lt;b&gt;kontrol_t&lt;/b&gt; paketi buyrukla birlikte D2 → R1 → R2 → E → W taşınır; her kademe yalnız kendi alanlarını kullanır&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="372" y="500" width="552" height="40" as="geometry"/></mxCell><mxCell id="c58" value="ilk adres" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.23;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c36" target="c42"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="276" y="358"/><mxPoint x="60" y="358"/></Array></mxGeometry></mxCell><mxCell id="c59" value="getir_izin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.08;exitY=1;exitDx=0;exitDy=0;entryX=0.71;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c42"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="592" y="386"/><mxPoint x="110" y="386"/></Array></mxGeometry></mxCell><mxCell id="c60" value="&lt;b style='font-size:15px'&gt;KONTROL BİRİMİ&lt;/b&gt;&lt;span style='font-size:12px'&gt;&amp;nbsp;&amp;nbsp;kombinasyonel · aynı kelime her zaman aynı paket&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="588" width="920" height="470" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b style='font-size:12.5px'&gt;cla_pkg.sv&lt;/b&gt;&lt;span style='font-size:11px'&gt;&amp;nbsp;&amp;nbsp;op_e (74 kimlik + OP_GECERSIZ) · CNDF kodları · adresleme kipleri · alanlar_t · kontrol_t · alu_kontrol_t&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="36" y="622" width="888" height="40" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b style='font-size:13px'&gt;cla_decoder (D1)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;1) tanıma: unique casez · 78 desen = cla_type0.yaml&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;MAR0/MAR1 çiftleri tek kimlik, seçim mar_x&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;2) alanlar: varsayılan konum, gruba göre ez&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;ra–rf · addr_kip · cndf (yoksa UNCF) · shift + 1 · m&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;3) kip_gecersiz: bellek buyruğu ve addr ∉ {0000, 0001, 0010}&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;çıkış → op · alan · gecersiz · kip_gecersiz&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="36" y="676" width="430" height="136" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b style='font-size:13px'&gt;cla_ctrl_gen (D2)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;k = 0 → buyruk yalnız kendi alanlarını doldurur&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;port: a 1. kaynak · b 2. kaynak · c, d paralel ve MMACF32&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;mux: 00 a · 01 b · 10 c · 11 d (1–2 topla, 3–4 çarp, 5–6 tamsayı,&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;7 kestirim, 8–9 karşılaştırma, 10 dönüşüm)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;geçersiz ya da kip_gecersiz → paket 0, gecersiz = 1&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="494" y="676" width="430" height="136" as="geometry"/></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c62" target="c63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c65" value="kelime" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c44" target="c62"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="312" y="576"/><mxPoint x="28" y="576"/><mxPoint x="28" y="750"/></Array></mxGeometry></mxCell><mxCell id="c66" value="&lt;b style='font-size:15px'&gt;kontrol_t paketi&lt;/b&gt;&lt;span style='font-size:12px'&gt;&amp;nbsp;&amp;nbsp;yalnız statik bilgi; RND32, geçerli, dur_exe, koşul sonucu üst modülde eklenir&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="36" y="828" width="888" height="214" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b style='font-size:12.5px'&gt;D2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;gecersiz&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;bellek_adres&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;dal&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;mstop&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;kosul&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="48" y="862" width="117" height="168" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b style='font-size:12.5px'&gt;R1/R2&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;bellek_oku&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;00 yok · 01 16 bit&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;11 32 bit&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="173" y="862" width="117" height="168" as="geometry"/></mxCell><mxCell id="c69" value="&lt;b style='font-size:12.5px'&gt;E: ALU&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;→ ALU&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;alu (17 kontrol)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;a/b/c_mr&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;d_kaynak · d_mr&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;okunan_mr&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="298" y="862" width="117" height="168" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b style='font-size:12.5px'&gt;E: MR&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;exe_yaz · hedef&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;exe_kaynak (8)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;exe_yaz_2 (MSWAPF)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;exe_kosullu&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="423" y="862" width="117" height="168" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b style='font-size:12.5px'&gt;E: MAR&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;mar_yukle&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;mar_hedef&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;mar_kaynak&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="548" y="862" width="117" height="168" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b style='font-size:12.5px'&gt;E: MSTF&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;zn_kaynak (5)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;lvf_luf_kestirme&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;tf · meallow&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;msetflg · mstf_yukle&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="673" y="862" width="117" height="168" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b style='font-size:12.5px'&gt;W&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;bellek_yaz&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;yaz_veri&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;yaz_adres_arti2&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="798" y="862" width="117" height="168" as="geometry"/></mxCell><mxCell id="c74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c63" target="c66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c75" value="&lt;b style='font-size:15px'&gt;DURUM MODÜLLERİ&lt;/b&gt;&lt;span style='font-size:12px'&gt;&amp;nbsp;&amp;nbsp;karar vermez · izinle günceller · içeriği sürekli gösterir&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="1082" width="920" height="246" as="geometry"/></mxCell><mxCell id="c76" value="&lt;b style='font-size:13px'&gt;cla_mr_regs&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&lt;i&gt;← E: MR grubu&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MR0–MR3 · 4 × 32 bit&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;4 çıkış (okuma portu yok)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;2 yazma portu&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;port 1: yalnız port 0 boşta&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&amp;nbsp;&amp;nbsp;ve adresler aynıysa yazar&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;golden: çevrimde 4 yazma&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="36" y="1116" width="214" height="196" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b style='font-size:13px'&gt;cla_mar_regs&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&lt;i&gt;← D2 ve E: MAR grubu&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;MAR0, MAR1 · 2 × 16 bit&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;tek mar_sel&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;öncelik: yükle &gt; +1 &gt; −1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;golden: D2'de MARx += m,&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&amp;nbsp;&amp;nbsp;E'de yükleme;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&amp;nbsp;&amp;nbsp;çakışmada artış kazanır&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="260" y="1116" width="214" height="196" as="geometry"/></mxCell><mxCell id="c78" value="&lt;b style='font-size:13px'&gt;cla_mstf_reg&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&lt;i&gt;← E: MSTF grubu&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;0 LVF · 1 LUF · 2 NF · 3 ZF&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;6 TF · 9 RND32 · 11 MEALLOW&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;23:12 RPC&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;tam yükleme &gt; ayrı güncellemeler&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;ZF = sonuç[30:0] = 0, NF = [31]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;LVF/LUF yapışkan&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="484" y="1116" width="214" height="196" as="geometry"/></mxCell><mxCell id="c79" value="&lt;b style='font-size:13px'&gt;cla_data_ram&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;&lt;i&gt;← R1/R2 ve W grupları&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;2¹¹ × 16 bit = 4 KB (L1 + L2)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;01: 16 bit · 11: 32 bit&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;alt yarı addr, üst addr + 1&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;okuma 1 çevrim (R1 → R2)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;okunmayan yarı 0&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px'&gt;tek port · W ile R1 çakışır&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="708" y="1116" width="216" height="196" as="geometry"/></mxCell><mxCell id="c80" value="yazma izinleri · hedefler · genişlikler" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;labelPosition=right;align=left;spacingLeft=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c66" target="c75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c81" value="&lt;b style='font-size:13.5px'&gt;ALU (CLA_ALU)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;a, b, c, d portları ← MR çıkışları, anlık değer, kaydırma, R2 verisi · mux 1–10 · RND32 MSTF'den&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;topla_cntrl = {hedef, RND32, kullan ∧ geçerli ∧ ¬dur_exe, çıkarma} · carpma_cntrl benzer · donusum_cntrl = {RND32, işlem}&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;sonuç: E'de (tamsayı, kestirim, karşılaştırma, dönüşüm) ya da W'de K2 (toplayıcı, çarpıcı) → MR, bayraklar → MSTF&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="1352" width="920" height="82" as="geometry"/></mxCell><mxCell id="c82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c66" target="c81"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="958" y="935"/><mxPoint x="958" y="1383"/></Array></mxGeometry></mxCell><mxCell id="c83" value="MR0–MR3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.07;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c76" target="c81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c84" value="sonuç → MR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.16;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c81" target="c76"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c85" value="RND32 · bayraklar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.64;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c78" target="c81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c86" value="R2 verisi → d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.3;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.88;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c79" target="c81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c87" value="&lt;b style='font-size:14px'&gt;Üst modülde karar verilecek bağlantı noktaları&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;1. Görev başlatma tek yerde: ctrl_regs'in task_start_req'i yerine denetçinin gorev_basla/no/bitti olayları; MCTL (SOFT/HARDRESET) eklenmeli&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;2. MR dosyası 4 yazma portu (E: 2, K2: 2) · öncelik E &gt; toplayıcı K2 &gt; çarpıcı K2 · port 1 koşulu: !(wr_en_0 &amp;&amp; wr_addr_0 == wr_addr_1)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;3. MAR: D2'de MARx += m (16 bit ofset) ve E'de yükleme ayrı yollar · aynı MAR'da aynı çevrimde artış kazanır&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;4. MSTF: ZF/NF hazır değer olarak (zn_kaynak) · LVF/LUF ayrı izinle (K2 ve kestirim) · MMOV32 MSTF'de MEALLOW korunur&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;MSETFLG = birleşik tam yükleme · MCCNDD: RPC = dallanma adresi + 8&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;5. Veri RAM: blok başına bir örnek (L1, L2: ADDR_WIDTH = 10) · 32 bitte adresin bit 0'ı sıfırlanır · taban 0x8800/0x8C00 çıkarılır&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;6. Kontrol üretici varsayımları (koşulsuz MAR artışı, ayrılmış kip = geçersiz) referans boru hattı modeliyle uyumlu&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;7. Denetçi zamanlaması golden ile aynı (n → n+3); boştan başlamada 2 hakem çevrimi kılavuzda yok (varsayım)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="1458" width="920" height="166" as="geometry"/></mxCell><mxCell id="c88" value="&lt;b style='font-size:14px'&gt;Golden modelle yapılan karşılaştırmalar (ekip dosyalarına dokunulmadan)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;cla_decoder + cla_ctrl_gen ↔ decoder.py · dagitici.py · erisim.py: 139.000 kelime, 0 fark&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;geçerli/geçersiz (55.387 geçersiz) · 74 sözdizim ↔ 74 kimlik · alanlar · ayrılmış kip (44.019)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;adres · okuma/yazma genişliği · MAR yükleme · dal · MSTOP · okunan MR · K2 hedefleri · koşul&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;Verilator 5.052 -Wall: 10 dosya, hata yok (yalnız kozmetik uyarılar)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;Örnek görev (MMOV32 · MMPYF32 · MMOV32 · MSTOP): 11 çevrim, 1 dur_exe, [0x8802] = 9,0&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11.5px'&gt;Paralel FP (K2) + MSWAPF (E): aynı çevrimde MR0–MR3'ün dördü birden yazılır&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="1646" width="920" height="124" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>