" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1318" y="297.2" width="290" height="722" as="geometry"/></mxCell><mxCell id="c115" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="1454" y="1006.2" width="18" height="12" as="geometry"/></mxCell><mxCell id="c116" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#4d4d4d;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="658.2" as="sourcePoint"/><mxPoint x="340" y="658.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c117" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#4d4d4d;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1288" y="658.2" as="sourcePoint"/><mxPoint x="1318" y="658.2" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="s4" name="R1 · okuma adresi"><mxGraphModel dx="1000" dy="1000" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1628" pageHeight="947" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c118" value="&lt;b style='font-size:22px'&gt;Aşama R1: okuma adresi ve bellek portu&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1400" height="32" as="geometry"/></mxCell><mxCell id="c119" value="&lt;span style='font-size:13px'&gt;Okunacak veri bloğu ve blok içi adres çıkarılır, BRAM&amp;#x27;e verilir; adres R1 sonunda BRAM&amp;#x27;e girer, veri R2&amp;#x27;de çıkar. Aynı çevrimde W aynı bloğa yazıyorsa R1 bir çevrim bekler (dur_r1); port o çevrimde W&amp;#x27;nin yazmasına verilir.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1400" height="46" as="geometry"/></mxCell><mxCell id="c120" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c121" value="&lt;span style='font-size:12px'&gt;boru hattı yazmacı (FF)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c122" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#cdb6e6;strokeColor=#5b3f86;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="225" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c123" value="&lt;span style='font-size:12px'&gt;mimari durum (FF)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="245" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c124" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="388" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c125" value="&lt;span style='font-size:12px'&gt;kombinasyonel blok&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="408" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c126" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spac