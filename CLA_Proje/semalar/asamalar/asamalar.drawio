"1"><mxGeometry x="630" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c100" value="&lt;span style='font-size:12px'&gt;ALU&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="650" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c101" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#c9a227;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="695" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c102" value="&lt;span style='font-size:12px'&gt;önerilen arayüz (mevcut modülden farklı)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="715" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c103" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="1019" y="99" width="18" height="12" as="geometry"/></mxCell><mxCell id="c104" value="&lt;span style='font-size:12px'&gt;saat kenarı · &lt;b style='color:#2e7d32'&gt;▶ girdi&lt;/b&gt; · &lt;b style='color:#b71c1c'&gt;◀ çıktı&lt;/b&gt; · sağdaki sayı = bit&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1041" y="95" width="520" height="20" as="geometry"/></mxCell><mxCell id="c105" value="&lt;b style='font-size:12.5px'&gt;Dışarıdan gelen sinyaller&lt;/b&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:3px'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;sinyal&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:0 12px'&gt;&lt;b&gt;bit&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;kaynak&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MAR0, MAR1&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;16 · 16&lt;/b&gt;&lt;/td&gt;&lt;td&gt;MAR yazmaçları&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RPC&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;td&gt;MSTF&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;gorunen_5&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;W · görünen MSTF&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;dur_exe&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;W · dur_exe birimi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;dur_r1&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;R1 · dur_r1 birimi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;en_D1D2, en_D2R1, balon_D2R1&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1 · 1 · 1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;boru hattı denetimi&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="340" y="128" width="466" height="145.2" as="geometry"/></mxCell><mxCell id="c106" value="&lt;b style='font-size:12.5px'&gt;Dışarı giden sinyaller&lt;/b&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:3px'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;sinyal&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:0 12px'&gt;&lt;b&gt;bit&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;hedef&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;dal_alindi, dal_hedef&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1 · 12&lt;/b&gt;&lt;/td&gt;&lt;td&gt;F1 · sonraki adres&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;mar_artis_en/_sec/_deger&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1 · 1 · 16&lt;/b&gt;&lt;/td&gt;&lt;td&gt;MAR yazmaçları&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rpc_en, rpc_deger&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1 · 12&lt;/b&gt;&lt;/td&gt;&lt;td&gt;MSTF&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;d2_gecerli, d2_mstop, d2_gecersiz&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1 · 1 · 1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;görev denetçisi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;mpc_en, mpc_deger&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1 · 12&lt;/b&gt;&lt;/td&gt;&lt;td&gt;MPC&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="822" y="128" width="466" height="129.6" as="geometry"/></mxCell><mxCell id="c107" value="&lt;b style='font-size:15px'&gt;D2 · kontrol, adres, dal&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#9e9e9e;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="340" y="297.2" width="948" height="722" as="geometry"/></mxCell><mxCell id="c108" value="&lt;b style='font-size:13px'&gt;cla_ctrl_gen&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;op ve alanlardan buyruğun bütün statik kararlarını (kontrol paketi) üretir. Kombinasyonel.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;op&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;7&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;alan&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;43&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;kip_gecersiz&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;k (kontrol_t)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;102&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;k = &amp;#x27;0;  k.kosul = alan.cndf&lt;br&gt;k.alu.karsilastirma_cndf = UNCF&lt;br&gt;case (op): her buyruk yalnız kendi alanlarını kurar&lt;br&gt;  ör. OP_MADDF32_RRR:&lt;br&gt;    a_mr = rb, b_mr = rc, okunan_mr = (1&amp;lt;&amp;lt;rb)|(1&amp;lt;&amp;lt;rc)&lt;br&gt;    alu.topla_kullan = 1, alu.topla_hedef = ra&lt;br&gt;    alu.mux[1] = 00 (a), alu.mux[2] = 01 (b)&lt;br&gt;  ör. OP_MMOV32_MEM_MR:&lt;br&gt;    bellek_adres = 1, bellek_yaz = 11,&lt;br&gt;    yaz_veri = VERI_MR, veri_mr = ra&lt;br&gt;op = OP_GECERSIZ ∨ kip_gecersiz:&lt;br&gt;    k = 0, k.gecersiz = 1&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="356" y="337.2" width="450" height="329.6" as="geometry"/></mxCell><mxCell id="c109" value="&lt;b style='font-size:13px'&gt;Etkin adres ve MAR artışı&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Bellek buyruğunun adresini kipe göre seçer; MAR kipinde MAR&amp;#x27;a ofseti ekler.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;addr_kip&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;4&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;m&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MAR0&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MAR1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;bellek_adres (k)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;d2_ilerle&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;ea&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mar_artis_en&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mar_artis_sec&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mar_artis_deger&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;ea = (addr_kip == 0000) ? m&lt;br&gt;   : (addr_kip == 0001) ? MAR0&lt;br&gt;   :                      MAR1   // 0010&lt;br&gt;mar_artis_en    = d2_ilerle ∧ bellek_adres ∧&lt;br&gt;                  addr_kip ∈ {0001, 0010}&lt;br&gt;mar_artis_sec   = addr_kip[1]   // 0: MAR0, 1: MAR1&lt;br&gt;mar_artis_deger = ea + m        // 16 bit&lt;br&gt;koşullu MMOV32&amp;#x27;de de artar (koşul E&amp;#x27;de)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="822" y="337.2" width="450" height="322" as="geometry"/></mxCell><mxCell id="c110" value="&lt;b style='font-size:13px'&gt;Dal birimi&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;MBCNDD, MCCNDD ve MRCNDD için koşulu değerlendirir, hedefi ve dönüş adresini üretir.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dal (k)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;kosul (k)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;4&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;pc&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;m&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;RPC&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;gorunen_5&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;d2_ilerle&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dal_alindi&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dal_hedef&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;rpc_en&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;rpc_deger&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;tuttu = CNDF(kosul, gorunen_5)   // koşul tablosu&lt;br&gt;dal_alindi = d2_ilerle ∧ (dal ≠ YOK) ∧ tuttu&lt;br&gt;dal_hedef  = (dal == MRCNDD) ? RPC&lt;br&gt;           : (pc + m)[11:0]   // taban = dalın adresi&lt;br&gt;rpc_en     = d2_ilerle ∧ (dal == MCCNDD) ∧ tuttu&lt;br&gt;rpc_deger  = pc + 8      // dal + 3 gecikme yuvası&lt;br&gt;gecikme yuvaları silinmez (F1–D1 sürer)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="822" y="675.2" width="450" height="324" as="geometry"/></mxCell><mxCell id="c111" value="&lt;b style='font-size:13px'&gt;D2 olayları&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;D2&amp;#x27;nin bu çevrimde işlenip işlenmediğini belirler; görev denetçisine ve MPC&amp;#x27;ye bildirir.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;geçerli&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dur_exe&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dur_r1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;gecersiz (k)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&g