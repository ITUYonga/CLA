t-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;geçerli&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dur_exe&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dondur&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;e_ilerle&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;e_ilerle = geçerli ∧ ¬dur_exe ∧ ¬dondur&lt;br&gt;E&amp;#x27;deki bütün yazma izinleri ve ALU valid&amp;#x27;leri&lt;br&gt;bununla VE&amp;#x27;lenir&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="356" y="352.8" width="450" height="192.2" as="geometry"/></mxCell><mxCell id="c192" value="&lt;b style='font-size:13px'&gt;MR okuma muxları&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Paketteki yazmaç numaralarıyla MR0–MR3&amp;#x27;ten gerekli değerleri seçer.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MR0–MR3&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;4 × 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;a_mr · b_mr · c_mr&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2 · 2 · 2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;d_mr&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;exe_kaynak_mr · _2&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2 · 2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;veri_mr&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;exe_hedef&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;a · b · c&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32 · 32 · 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MR[d_mr]&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MR[exe_kaynak_mr]&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;e_veri2&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MR[veri_mr]&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MR[exe_hedef]&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;8 adet 4:1 × 32 mux: çıkış = MR[seçim]&lt;br&gt;a = MR[a_mr], b = MR[b_mr], c = MR[c_mr]&lt;br&gt;e_veri2 = MR[exe_kaynak_mr_2]   // MSWAPF&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="822" y="352.8" width="450" height="239" as="geometry"/></mxCell><mxCell id="c193" value="&lt;b style='font-size:13px'&gt;Anlık genişletme&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Buyruktaki 16 bitlik değeri ve kaydırma miktarını 32 / 16 bitlik işlenenlere çevirir.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;m&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;shift&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MR[exe_hedef][31:16]&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MR[veri_mr][15:0]&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;imm_hi&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;imm_shift&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;imm_lo&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mar_imm&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mar_mr&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;imm_hi    = {m, 16&amp;#x27;h0}           // #16FHi, MMOVIZ&lt;br&gt;imm_shift = {26&amp;#x27;b0, shift}       // #SHIFT&lt;br&gt;imm_lo    = {MR[exe_hedef][31:16], m}  // MMOVXI&lt;br&gt;mar_imm   = m                    // MMOVI16&lt;br&gt;mar_mr    = MR[veri_mr][15:0] + m  // 16 bit&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1288" y="352.8" width="450" height="265.6" as="geometry"/></mxCell><mxCell id="c194" value="&lt;b style='font-size:13px'&gt;d kaynağı muxu&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;ALU&amp;#x27;nun d portunu seçer.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;d_kaynak (k)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MR[d_mr]&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;imm_hi&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;imm_shift&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;okunan&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;d&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;d = case (d_kaynak)&lt;br&gt;    00 D_MR:     MR[d_mr]&lt;br&gt;    01 D_IMM_HI: imm_hi&lt;br&gt;    10 D_SHIFT:  imm_shift&lt;br&gt;    11 D_BELLEK: okunan&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="356" y="561" width="450" height="250.6" as="geometry"/></mxCell><mxCell id="c195" value="&lt;b style='font-size:13px'&gt;ALU kontrol sözcükleri&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Paketin alu alanını ALU.sv&amp;#x27;nin kontrol girişlerine dağıtır, dinamik bitleri ekler.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;alu (k)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;42&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;e_ilerle&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;RND32&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;gorunen_5&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;topla_cntrl · carpma_cntrl&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;5 · 5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;tamsayi_cntrl · kestirme_cntrl&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;3 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;karsilastirma_cntrl&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;7&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;donusum_cntrl&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mux_1 … mux_10&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;10 × 2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mstf_in&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;topla_cntrl  = {topla_hedef, RND32,&lt;br&gt;                topla_kullan ∧ e_ilerle, topla_cikarma}&lt;br&gt;carpma_cntrl = {carp_hedef, RND32,&lt;br&gt;                carp_kullan ∧ e_ilerle, 1&amp;#x27;b0}&lt;br&gt;tamsayi_cntrl = tamsayi_islem&lt;br&gt;kestirme_cntrl = kestirme_islem&lt;br&gt;karsilastirma_cntrl = {karsilastirma_islem, _cndf}&lt;br&gt;donusum_cntrl = {RND32, donusum_islem}&lt;br&gt;mux_i = alu.mux[i]&lt;br&gt;mstf_in = gorunen_5   // {TF, ZF, NF, LUF, LVF}&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="822" y="607.8" width="450" height="349.2" as="geometry"/></mxCell><mxCell id="c196" value="&lt;b style='font-size:13px'&gt;ALU, E kısmı&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Birim girişlerini seçer, kombinasyonel birimleri çalıştırır, toplama/çarpmanın K1&amp;#x27;ini yapar.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;a · b · c · d&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;4 × 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;topla_cntrl · carpma_cntrl&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;5 · 5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;tamsayi_cntrl · kestirme_cntrl&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;3 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;karsilastirma_cntrl&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;7&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;donusum_cntrl&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mux_1 … mux_10&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;10 × 2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mstf_in&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;result_tamsayi&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mstf_out&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;result_kestirme&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;lvf/luf_kestirme&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;result_karsilastirma&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;zf/nf_karsilastirma&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;result_donusum&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;K (topla) D · K (çarp) D&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;70 · 65&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;mux_i: 00 a · 01 b · 10 c · 11 d → birim girişi&lt;br&gt;tamsayi_islem: 3 bit kodla 8 işlem (+ − &amp;amp; | ^ &amp;lt;&amp;lt; &amp;gt;&amp;gt; &amp;gt;&amp;gt;&amp;gt;)&lt;br&gt;   ZF = (sonuç == 0), NF = sonuç[31] → mstf_out[3:2]&lt;br&gt;fpu_kestirme: 1/x ya da 1/√x, estimate_lut.hex&lt;br&gt;fpu_karsilastirma: CMP, MAX, MIN, ABS, NEG&lt;br&gt;   NEG: koşul = CNDF(cndf, mstf_in) → −x ya da x&lt;br&gt;fpu_donusum: 11 dönüşüm, RND32 yalnız int → float&lt;br&gt;topla_k1: sınıflandır, işaret, büyük üs, hizala&lt;br&gt;carp_k1: sınıflandır, işaret XOR, üs topla, 24×24&lt;br&gt;K1 sonucu kenarda ALU içindeki K yazmacına girer&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e9f5e4;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1288" y="634.4" width="450" height="380.4" as="geometry"/></mxCell><mxCell id="c197" value="&lt;b style='font-size:13px'&gt;Koşul değerlendirici&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Koşullu yazmalar ve MTESTTF için CNDF&amp;#x27;yi görünen bayraklarla değerlendirir.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;kosul (k)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;4&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;gorunen_5&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;kosul_tuttu&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;0000 ZF=0      0001 ZF=1&lt;br&gt;0010 ZF=0∧NF=0 0011 NF=0&lt;br&gt;0100 NF=1      0101 ZF=1∨NF=1&lt;br&gt;1010 TF=1      1011 TF=0&lt;br&gt;1100 LUF=1     1101 LVF=1&lt;br&gt;1110, 1111 her zaman · 0110–1001 ayrılmış&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="356" y="827.6" width="450" height="232.4" as="geometry"/></mxCell><mxCell id="c198" value="&lt;b style='font-size:13px'&gt;E yazma izinleri&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;E&amp;#x27;nin MR, MAR ve MSTF yazmalarına izin verir.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;e_ilerle&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;kosul_tuttu&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;exe_yaz · exe_yaz_2&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;exe_kosullu&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mar_yukle&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;zn_kaynak&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;3&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;tf_yaz · meallow_yaz&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;msetflg · mstf_yukle&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;lvf_luf_kestirme&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;e_yaz1 · e_yaz2&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mar_yaz&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mstf_izin&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;k_ok   = ¬exe_kosullu ∨ kosul_tuttu&lt;br&gt;e_yaz1 = e_ilerle ∧ exe_yaz   ∧ k_ok&lt;br&gt;e_yaz2 = e_ilerle ∧ exe_yaz_2 ∧ k_ok&lt;br&gt;mar_yaz = e_ilerle ∧ mar_yukle&lt;br&gt;mstf_izin = e_ilerle ∧ {zn_kaynak ≠ 0, tf_yaz,&lt;br&gt;   meallow_yaz, msetflg, mstf_yukle, lvf_luf_kestirme}&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="822" y="973" width="450" height="326.6" as="geometry"/></mxCell><mxCell id="c199" value="&lt;b style='font-size:13px'&gt;E sonuç muxu&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;MR&amp;#x27;ye E&amp;#x27;de yazılacak değeri seçer.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;exe_kaynak (k)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;3&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;result_tamsayi · _kestirme&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32 · 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;result_karsilastirma · _donusum&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32 · 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;okunan&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;imm_hi · imm_lo&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32 · 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MR[exe_kaynak_mr]&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;e_veri1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;e_veri1 = case (exe_kaynak)&lt;br&gt;  0 result_tamsayi     1 result_kestirme&lt;br&gt;  2 result_karsilastirma  3 result_donusum&lt;br&gt;  4 okunan  5 imm_hi  6 imm_lo  7 MR[exe_kaynak_mr]&lt;br&gt;e_veri1 → MR[exe_hedef], e_veri2 → MR[exe_hedef_2]&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1288" y="1030.8" width="450" height="266.2" as="geometry"/></mxCell><mxCell id="c200" value="&lt;b style='font-size:13px'&gt;ZF/NF birimi&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Buyruğun ZF ve NF değerlerini doğru kuralla üretir.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;zn_kaynak (k)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;3&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mstf_out[3:2]&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;zf/nf_karsilastirma&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;e_veri1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;zf_e · nf_e&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;case (zn_kaynak)&lt;br&gt; 1 TAMSAYI:    {zf, nf} = mstf_out[3:2]&lt;br&gt; 2 KARŞILAŞTIRMA: {zf, nf} = {zf_karş, nf_karş}&lt;br&gt; 3 YAZILAN_FLOAT: zf = (e_veri1[30:23] == 0)&lt;br&gt;                  nf = e_veri1[31] ∧ ¬zf&lt;br&gt; 4 YAZILAN_TAMSAYI: zf = (e_veri1 == 0)&lt;br&gt;                    nf = e_veri1[31]&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="356" y="1076" width="450" height="262.2" as="geometry"/></mxCell><mxCell id="c201" value="&lt;b style='font-size:13px'&gt;MSTF, E güncellemesi&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;E&amp;#x27;nin MSTF&amp;#x27;ye yazacağı alanları ve hangi alanların yazılacağını (maske) üretir.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;zf_e · nf_e&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;kosul_tuttu&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;meallow_deger&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;m&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;okunan&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;lvf/luf_kestirme&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mstf_izin&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;e_mstf_veri&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;19&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;e_mstf_maske&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;19&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;alan sırası: {RPC 12, MEALLOW, RND32, TF, ZF, NF, LUF, LVF}&lt;br&gt;zn:      ZF, NF &amp;lt;= zf_e, nf_e&lt;br&gt;tf:      TF &amp;lt;= kosul_tuttu&lt;br&gt;meallow: MEALLOW &amp;lt;= meallow_deger&lt;br&gt;msetflg: FLAG = m[15:8], VALUE = m[7:0]&lt;br&gt;  FLAG bit 0 1 2 3 6 7 → LVF LUF NF ZF TF RND32&lt;br&gt;  FLAG[i] = 1 olan alan &amp;lt;= VALUE[i]&lt;br&gt;yükleme: RPC, RND32, TF, ZF, NF, LUF, LVF &amp;lt;= okunan&lt;br&gt;  (MEALLOW korunur, maskesi 0)&lt;br&gt;kestirim: LVF/LUF &amp;lt;= 1 (yalnız lvf/luf_kestirme = 1)&lt;br&gt;maske = yazılan alanlar&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1288" y="1313" width="450" height="378.4" as="geometry"/></mxCell><mxCell id="c202" value="&lt;b style='font-size:13px'&gt;MAR yükleme&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;MAR&amp;#x27;a E&amp;#x27;de yüklenecek değeri seçer.&lt;/i&gt;&lt;/div&gt;&lt;table st