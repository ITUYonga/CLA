x="1" parent="1"><mxGeometry x="1041" y="95" width="520" height="20" as="geometry"/></mxCell><mxCell id="c134" value="&lt;b style='font-size:12.5px'&gt;Dışarıdan gelen sinyaller&lt;/b&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:3px'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;sinyal&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:0 12px'&gt;&lt;b&gt;bit&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;kaynak&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;w_gecerli, w_bellek_yaz&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1 · 2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;E/W yazmacı&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;w_blok, w_adr, w_wr_en, w_din&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;2 · 10 · 2 · 32&lt;/b&gt;&lt;/td&gt;&lt;td&gt;W · RAM yazma&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;dur_exe&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;W · dur_exe birimi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;en_D2R1, en_R1R2, balon_R1R2&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1 · 1 · 1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;boru hattı denetimi&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="340" y="128" width="466" height="114" as="geometry"/></mxCell><mxCell id="c135" value="&lt;b style='font-size:12.5px'&gt;Dışarı giden sinyaller&lt;/b&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:3px'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;sinyal&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:0 12px'&gt;&lt;b&gt;bit&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;hedef&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;L1, L2, C2M, M2C portları&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;bkz. port seçici&lt;/b&gt;&lt;/td&gt;&lt;td&gt;veri BRAM&amp;#x27;leri&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;dur_r1&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;boru hattı denetimi, D2, R1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="822" y="128" width="466" height="82.8" as="geometry"/></mxCell><mxCell id="c136" value="&lt;b style='font-size:15px'&gt;R1 · okuma adresi&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#9e9e9e;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="340" y="266" width="948" height="651.2" as="geometry"/></mxCell><mxCell id="c137" value="&lt;b style='font-size:13px'&gt;Okuma adresi&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;ea&amp;#x27;dan bloğu ve blok içi adresi çıkarır, okuma iznini üretir.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;ea&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;bellek_oku (k)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;geçerli&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dur_exe&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dur_r1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;r1_blok&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;r1_adr&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;10&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;r1_rd_en&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;r1_blok = 0x8800–0x8BFF: L1 (00)&lt;br&gt;          0x8C00–0x8FFF: L2 (01)&lt;br&gt;          0x1480–0x14FF: C2M (10)&lt;br&gt;          0x1500–0x157F: M2C (11)&lt;br&gt;r1_adr  = ea − taban&lt;br&gt;          32 bit erişimde r1_adr[0] = 0 (çifte hizala)&lt;br&gt;r1_rd_en = (geçerli ∧ ¬dur_exe ∧ ¬dur_r1)&lt;br&gt;           ? bellek_oku : 00&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="356" y="306" width="450" height="291.4" as="geometry"/></mxCell><mxCell id="c138" value="&lt;b style='font-size:13px'&gt;dur_r1 birimi&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;W&amp;#x27;deki yazma ile R1&amp;#x27;deki okumanın aynı bloğa düşmesini yakalar.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;r1_gecerli&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;bellek_oku&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;r1_blok&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;w_gecerli&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;w_bellek_yaz&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;w_blok&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dur_r1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;dur_r1 = r1_gecerli ∧ (bellek_oku ≠ 00) ∧&lt;br&gt;         w_gecerli ∧ (w_bellek_yaz ≠ 00) ∧&lt;br&gt;         (r1_blok == w_blok) ∧ (r1_blok ≠ M2C)&lt;br&gt;kombinasyonel; dur_exe ile birlikteyse dur_exe baskın&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="822" y="306" width="450" height="252.6" as="geometry"/></mxCell><mxCell id="c139" value="&lt;b style='font-size:13px'&gt;RAM port seçici&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Her bloğun tek portunu ya W&amp;#x27;nin yazmasına ya R1&amp;#x27;in okumasına verir.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;r1_blok&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;r1_adr&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;10&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;r1_rd_en&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;w_blok&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;w_adr&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;10&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;w_wr_en&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;w_din&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;L1: addr · rd_en · wr_en · din&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;10 · 2 · 2 · 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;L2: addr · rd_en · wr_en · din&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;10 · 2 · 2 · 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;C2M: addr · rd_en · wr_en · din&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;7 · 2 · 2 · 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;M2C: addr · rd_en&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;7 · 2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;her blok b için:&lt;br&gt;  W bu bloğa yazıyorsa (w_wr_en ≠ 0 ∧ w_blok == b):&lt;br&gt;    addr = w_adr, wr_en = w_wr_en, din = w_din,&lt;br&gt;    rd_en = 00&lt;br&gt;  değilse:&lt;br&gt;    addr = r1_adr, wr_en = 00,&lt;br&gt;    rd_en = (r1_blok == b) ? r1_rd_en : 00&lt;br&gt;dur_r1 aynı bloktaki çakışmayı zaten önler&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="822" y="574.6" width="450" height="322.6" as="geometry"/></mxCell><mxCell id="c140" value="&lt;b style='font-size:13px'&gt;D2/R1 · 185 FF&lt;/b&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;D2&amp;#x27;den alanlar&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;185&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;en_D2R1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;balon_D2R1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;clk · rst_n&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;geçerli&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;pc&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;kelime *&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;k (kontrol_t)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;102&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;ea&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;m&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;shift&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;toplam&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;185&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;saat kenarında:&lt;br&gt;  balon ise geçerli &amp;lt;= 0&lt;br&gt;  değilse en ise Q &amp;lt;= D&lt;br&gt;  en = 0 ise Q korunur&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="266" width="290" height="651.2" as="geometry"/></mxCell><mxCell id="c141" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="156" y="904.2" width="18" height="12" as="geometry"/></mxCell><mxCell id="c142" value="&lt;b style='font-size:13px'&gt;R1/R2 · 185 FF&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;R2&amp;#x27;deki buyruk. BRAM&amp;#x27;lerin adres/veri yazmacı da bu kenardadır.&lt;/i&gt;&lt;/div&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;D2/R1 alanları&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;185&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;en_R1R2&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;balon_R1R2&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;clk · rst_n&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;geçerli&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;pc&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;kelime *&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;k (kontrol_t)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;102&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;ea&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;m&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;shift&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;toplam&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;185&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;saat kenarında:&lt;br&gt;  balon ise geçerli &amp;lt;= 0&lt;br&gt;  değilse en ise Q &amp;lt;= D&lt;br&gt;  en = 0 ise Q korunur&lt;br&gt;dur_r1 ise balon_R1R2 = 1&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1318" y="266" width="290" height="651.2" as="geometry"/></mxCell><mxCell id="c143" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="1454" y="904.2" width="18" height="12" as="geometry"/></mxCell><mxCell id="c144" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#4d4d4d;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="591.6" as="sourcePoint"/><mxPoint x="340" y="591.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c145" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#4d4d4d;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1288" y="591.6" as="sourcePoint"/><mxPoint x="1318" y="591.6" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="s5" name="R2 · okunan veri"><mxGraphModel dx="1000" dy="1000" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1628" pageHeight="678" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c146" value="&lt;b style='font-size:22px'&gt;Aşama R2: okunan verinin seçilmesi&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1400" height="32" as="geometry"/></mxCell><mxCell id="c147" value="&lt;span style='font-size:13px'&gt;R1 sonunda BRAM&amp;#x27;lere giren adreslerin verisi R2 boyunca BRAM çıkışlarında durur. Buyruğun okuduğu bloğun çıkışı seçilir, 16 bitlik erişimde üst yarı sıfırlanır ve R2/E&amp;#x27;ye yazılır.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1400" height="46" as="geometry"/></mxCell><mxCell id="c148" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c149" value="&lt;span style='font-size:12px'&gt;boru hattı yazmacı (FF)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c150" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#cdb6e6;strokeColor=#5b3f86;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="225" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c151" value="&lt;span style='font-size:12px'&gt;mimari durum (FF)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="245" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c152" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="388" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c153" value="&lt;span style='font-size:12px'&gt;kombinasyonel blok&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="408" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c154" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="558" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c155" value="&lt;span style='font-size:12px'&gt;BRAM&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="578" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c156" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e9f5e4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="630" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c157" value="&lt;span style='font-size:12px'&gt;ALU&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="650" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c158" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#c9a227;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="695" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c159" value="&lt;span style='font-size:12px'&gt;önerilen arayüz (mevcut modülden farklı)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="715" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c160" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="1019" y="99" width="18" height="12" as="geometry"/></mxCell><mxCell id="c161" value="&lt;span style='font-size:12px'&gt;saat kenarı · &lt;b style='color:#2e7d32'&gt;▶ girdi&lt;/b&gt; · &lt;b style='color:#b71c1c'&gt;◀ çıktı&lt;/b&gt; · sağdaki sayı = bit&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1041" y="95" width="520" height="20" as="geometry"/></mxCell><mxCell id="c162" value="&lt;b style='font-size:12.5px'&gt;Dışarıdan gelen sinyaller&lt;/b&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:3px'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;sinyal&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:0 12px'&gt;&lt;b&gt;bit&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;kaynak&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;C2M, M2C dout&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;32 · 32&lt;/b&gt;&lt;/td&gt;&lt;td&gt;köprü (cla_kopru_cekirdek)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;en_R1R2, en_R2E&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;boru hattı denetimi&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="340" y="128" width="948" height="82.8" as="geometry"/></mxCell><mxCell id="c163" value="&lt;b style='font-size:15px'&gt;R2 · okunan veri&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#9e9e9e;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="340" y="234.8" width="948" height="414" as="geometry"/></mxCell><mxCell id="c164" value="&lt;b style='font-size:13px'&gt;Veri BRAM (L1, L2: her biri)&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;1K × 16 veri bloğu, tek port. 32 bit erişimde adr ve adr + 1 birlikte.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;addr&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;10&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;wr_en&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;rd_en&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;din&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;clk&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dout&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;saat kenarında:&lt;br&gt;  wr_en[0]: mem[addr]     &amp;lt;= din[15:0]&lt;br&gt;  wr_en[1]: mem[addr + 1] &amp;lt;= din[31:16]&lt;br&gt;  rd_en ≠ 0: dout &amp;lt;= {mem[addr + 1], mem[addr]}&lt;br&gt;  rd_en = 0: dout korunur&lt;br&gt;(cla_data_ram şu an rd_en = 0&amp;#x27;da dout&amp;#x27;u 0&amp;#x27;lıyor)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="356" y="274.8" width="450" height="264.2" as="geometry"/></mxCell><mxCell id="c165" value="&lt;b style='font-size:13px'&gt;Okunan seçici&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Buyruğun okuduğu bloğun çıkışını seçer ve genişliğe göre düzenler.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dout_L1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dout_L2&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dout_C2M&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dout_M2C&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;ea&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;bellek_oku (k)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;okunan&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;blok = çöz(ea)          // R1 ile aynı kural&lt;br&gt;okunan = dout_blok&lt;br&gt;bellek_oku == 01 (16 bit): okunan[31:16] = 0&lt;br&gt;C2M, M2C: köprüdeki mesaj RAM&amp;#x27;lerinin CLA portu&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="822" y="274.8" width="450" height="252.6" as="geometry"/></mxCell><mxCell id="c166" value="&lt;b style='font-size:13px'&gt;R1/R2 · 185 FF&lt;/b&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;D2/R1 alanları&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;185&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;en_R1R2&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;balon_R1R2&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;clk · rst_n&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;geçerli&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;pc&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;kelime *&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;k (kontrol_t)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;102&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;ea&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;m&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;shift&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;toplam&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;185&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;saat kenarında:&lt;br&gt;  balon ise geçerli &amp;lt;= 0&lt;br&gt;  değilse en ise Q &amp;lt;= D&lt;br&gt;  en = 0 ise Q korunur&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="234.8" width="290" height="414" as="geometry"/></mxCell><mxCell id="c167" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="156" y="635.8" width="18" height="12" as="geometry"/></mxCell><mxCell id="c168" value="&lt;b style='font-size:13px'&gt;R2/E · 217 FF&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;E&amp;#x27;deki buyruk: paket, adres, anlık değerler ve okunan veri.&lt;/i&gt;&lt;/div&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;R1/R2 alanları&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;185&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;okunan&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;en_R2E&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;balon_R2E&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;clk · rst_n&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;geçerli&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;pc&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;kelime *&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;k (kontrol_t)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;102&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;ea&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;m&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;shift&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;okunan&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;toplam&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;217&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;saat kenarında:&lt;br&gt;  balon ise geçerli &amp;lt;= 0&lt;br&gt;  değilse en ise Q &amp;lt;= D&lt;br&gt;  en = 0 ise Q korunur&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1318" y="234.8" width="290" height="414" as="geometry"/></mxCell><mxCell id="c169" value="" style="triangle;