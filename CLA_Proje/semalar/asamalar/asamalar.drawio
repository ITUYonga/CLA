llapse;margin-top:3px'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;sinyal&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:0 12px'&gt;&lt;b&gt;bit&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;hedef&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;mr_en, mr_veri&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;4 · 4 × 32&lt;/b&gt;&lt;/td&gt;&lt;td&gt;MR yazmaçları&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;w_lvf_set, w_luf_set&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;MSTF&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;dur_exe&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;boru hattı denetimi, D2, R1, E&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;gorunen_5, gorunen_32&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;5 · 32&lt;/b&gt;&lt;/td&gt;&lt;td&gt;D2, E&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;w_blok, w_adr, w_wr_en, w_din&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;2 · 10 · 2 · 32&lt;/b&gt;&lt;/td&gt;&lt;td&gt;R1 · RAM port seçici, dur_r1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1055" y="128" width="699" height="129.6" as="geometry"/></mxCell><mxCell id="c228" value="&lt;b style='font-size:15px'&gt;W · geri yazma&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#9e9e9e;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="340" y="281.6" width="1414" height="775.2" as="geometry"/></mxCell><mxCell id="c229" value="&lt;b style='font-size:13px'&gt;ALU, W kısmı (K2)&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;K yazmacındaki ara sonucu normalleştirir, yuvarlar ve paketler.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;K (topla) Q&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;70&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;K (çarp) Q&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;65&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;result_topla&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;lvf_topla · luf_topla&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;valid_topla · hedef_mr_out_topla&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;result_carp&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;lvf_carp · luf_carp&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;valid_carp · hedef_mr_out_carp&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;topla_k2: topla ya da çıkar; taşmada sağa,&lt;br&gt;   baştaki sıfırlar kadar sola kaydır&lt;br&gt;carp_k2: 48 bit çarpımı normalleştir, G R S&lt;br&gt;pack: RND32 ile yuvarla; NaN = 0x7FC00000,&lt;br&gt;   taşma → LVF, alttan taşma → LUF (sonuç 0)&lt;br&gt;lvf/luf = pack ∧ valid,  valid/hedef = K&amp;#x27;dan&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e9f5e4;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="356" y="321.6" width="450" height="279.8" as="geometry"/></mxCell><mxCell id="c230" value="&lt;b style='font-size:13px'&gt;dur_exe birimi&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;E&amp;#x27;deki buyruk, W&amp;#x27;de K2&amp;#x27;nin yazacağı bir MR&amp;#x27;yi okuyorsa beklemeyi başlatır.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;geçerli (R2/E)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;okunan_mr (k)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;4&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;valid_topla · hedef_mr_out_topla&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;valid_carp · hedef_mr_out_carp&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dur_exe&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;k2_maske = (valid_topla ? 1 &amp;lt;&amp;lt; hedef_t : 0)&lt;br&gt;         | (valid_carp  ? 1 &amp;lt;&amp;lt; hedef_c : 0)&lt;br&gt;dur_exe  = geçerli ∧ |(okunan_mr &amp;amp; k2_maske)&lt;br&gt;kombinasyonel: aynı çevrimde etkili&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="822" y="321.6" width="450" height="236.4" as="geometry"/></mxCell><mxCell id="c231" value="&lt;b style='font-size:13px'&gt;MR yazma birimi&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Dört yazma kaynağını MR0–MR3&amp;#x27;ün izin ve verilerine çevirir.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;e_yaz1 · exe_hedef · e_veri1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 2 · 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;e_yaz2 · exe_hedef_2 · e_veri2&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 2 · 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;valid_topla · hedef_t · result_topla&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 2 · 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;valid_carp · hedef_c · result_carp&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 2 · 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dondur&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mr_en&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;4&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mr_veri&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;4 × 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;her x = 0..3 için:&lt;br&gt;  e1 = e_yaz1 ∧ (exe_hedef == x)&lt;br&gt;  e2 = e_yaz2 ∧ (exe_hedef_2 == x)&lt;br&gt;  t  = valid_topla ∧ (hedef_t == x) ∧ ¬dondur&lt;br&gt;  c  = valid_carp  ∧ (hedef_c == x) ∧ ¬dondur&lt;br&gt;  mr_en[x]   = e1 ∨ e2 ∨ t ∨ c&lt;br&gt;  mr_veri[x] = e1 ? e_veri1 : e2 ? e_veri2&lt;br&gt;             : t  ? result_topla : result_carp&lt;br&gt;öncelik: E &amp;gt; topla K2 &amp;gt; çarp K2&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1288" y="321.6" width="450" height="305" as="geometry"/></mxCell><mxCell id="c232" value="&lt;b style='font-size:13px'&gt;MSTF, W güncellemesi&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;K2&amp;#x27;nin taşma bayraklarını MSTF&amp;#x27;ye yapışkan olarak işler.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;lvf_topla · luf_topla&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;lvf_carp · luf_carp&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dondur&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;w_lvf_set · w_luf_set&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;w_lvf_set = (lvf_topla ∨ lvf_carp) ∧ ¬dondur&lt;br&gt;w_luf_set = (luf_topla ∨ luf_carp) ∧ ¬dondur&lt;br&gt;MSTF&amp;#x27;de: LVF &amp;lt;= E maskesi ? E verisi : LVF ∨ w_lvf_set&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="822" y="574" width="450" height="192.2" as="geometry"/></mxCell><mxCell id="c233" value="&lt;b style='font-size:13px'&gt;Görünen MSTF&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Bu çevrimde K2&amp;#x27;nin kurduğu LVF/LUF&amp;#x27;u da gösteren MSTF görünümü.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mstf_q&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;19&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;lvf_topla · luf_topla&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;lvf_carp · luf_carp&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;gorunen_5&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;gorunen_32&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;LVF&amp;#x27; = LVF ∨ lvf_topla ∨ lvf_carp&lt;br&gt;LUF&amp;#x27; = LUF ∨ luf_topla ∨ luf_carp&lt;br&gt;gorunen_5  = {TF, ZF, NF, LUF&amp;#x27;, LVF&amp;#x27;}&lt;br&gt;gorunen_32 = {8&amp;#x27;h0, RPC, MEALLOW, 0, RND32,&lt;br&gt;              00, TF, 00, ZF, NF, LUF&amp;#x27;, LVF&amp;#x27;}&lt;br&gt;kullanan: D2 dal, E koşul, ALU mstf_in, VERI_MSTF&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="356" y="617.4" width="450" height="233" as="geometry"/></mxCell><mxCell id="c234" value="&lt;b style='font-size:13px'&gt;RAM yazma&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;E/W&amp;#x27;deki bellek yazmasını blok, adres ve izin olarak RAM portuna verir.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;geçerli&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;bellek_yaz&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;yaz_adr&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;yaz_veri&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;w_blok&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;w_adr&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;10&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;w_wr_en&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;w_din&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;w_blok  = çöz(yaz_adr)   // L1, L2, C2M&lt;br&gt;w_adr   = yaz_adr − taban; 32 bitte w_adr[0] = 0&lt;br&gt;w_wr_en = geçerli ? bellek_yaz : 00&lt;br&gt;w_din   = yaz_veri&lt;br&gt;yazma, R1&amp;#x27;deki port seçiciden çevrim sonunda yapılır&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1288" y="642.6" width="450" height="235" as="geometry"/></mxCell><mxCell id="c235" value="&lt;b style='font-size:13px'&gt;İz çıkışı (yalnız tezgâh)&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Golden modelin izine karşılık gelen satırı her çevrim basar.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;R2/E pc · kelime&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12 · 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MPC&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MR0–MR3&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;4 × 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MAR0 · MAR1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16 · 16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;MSTF&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;E/W geçerli · bellek_yaz&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;E/W yaz_adr · yaz_veri&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16 · 32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;iz satırı&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;metin&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;cycle exe_pc exe_op mpc mr0..mr3 mar0 mar1 mstf&lt;br&gt;      wr_addr wr_data wr_w   (trace_format v1)&lt;br&gt;dur_exe&amp;#x27;de E satırı tekrarlanır&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="822" y="782.2" width="450" height="254.6" as="geometry"/></mxCell><mxCell id="c236" value="&lt;b style='font-size:13px'&gt;E/W · 63 FF + ALU K (135 FF)&lt;/b&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;E&amp;#x27;den alanlar&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;63&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;K (topla) D · K (çarp) D&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;70 · 65&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;en_EW · balon_EW&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;clk · rst_n&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;geçerli&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;pc *&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;bellek_yaz&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;yaz_adr&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;yaz_veri&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;32&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;K (topla) Q&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;70&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;K (çarp) Q&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;65&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;saat kenarında:&lt;br&gt;  balon ise geçerli &amp;lt;= 0&lt;br&gt;  değilse en ise Q &amp;lt;= D&lt;br&gt;  en = 0 ise Q korunur&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="281.6" width="290" height="775.2" as="geometry"/></mxCell><mxCell id="c237" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="156" y="1043.8" width="18" height="12" as="geometry"/></mxCell><mxCell id="c238" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#4d4d4d;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="669.2" as="sourcePoint"/><mxPoint x="340" y="669.2" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="s8" name="Durum ve denetim"><mxGraphModel dx="1000" dy="1000" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1454" pageHeight="1013" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c239" value="&lt;b style='font-size:22px'&gt;Ortak: durum yazmaçları, görev denetimi ve boru hattı denetimi&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1400" height="32" as="geometry"/></mxCell><mxCell id="c240" value="&lt;span style='font-size:13px'&gt;Birden fazla aşamanın okuduğu ya da yazdığı yazmaçlar ve bütün boru hattı yazmaçlarının izin (en) ve balon sinyalleri. Sarı kutular önerilen arayüzdür; mevcut modüllerin portlarından farklıdır.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1400" height="46" as="geometry"/></mxCell><mxCell id="c241" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c242" value="&lt;span style='font-size:12px'&gt;boru hattı yazmacı (FF)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c243" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#cdb6e6;strokeColor=#5b3f86;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="225" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c244" value="&lt;span style='font-size:12px'&gt;mimari durum (FF)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="245" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c245" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="388" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c246" value="&lt;span style='font-size:12px'&gt;kombinasyonel blok&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="408" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c247" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="558" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c248" value="&lt;span style='font-size:12px'&gt;BRAM&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="578" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c249" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e9f5e4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="630" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c250" value="&lt;span style='font-size:12px'&gt;ALU&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="650" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c251" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#c9a227;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="695" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c252" value="&lt;span style='font-size:12px'&gt;önerilen arayüz (mevcut modülden farklı)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="715" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c253" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="1019" y="99" width="18" height="12" as="geometry"/></mxCell><mxCell id="c254" value="&lt;span style='font-size:12px'&gt;saat kenarı · &lt;b style='color:#2e7d32'&gt;▶ girdi&lt;/b&gt; · &lt;b style='color:#b71c1c'&gt;◀ çıktı&lt;/b&gt; · sağdaki sayı = bit&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1041" y="95" width="520" height="20" as="geometry"/></mxCell><mxCell id="c255" value="&lt;b style='font-size:15px'&gt;Durum ve denetim&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#9e9e9e;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="128" width="1414" height="855.4" as="geometry"/></mxCell><mxCell id="c256" value="&lt;b style='font-size:13px'&gt;Boru hattı denetimi&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Beklemelere, görev olaylarına ve resete göre her boru hattı yazmacının yükleme izni ve balon girişini üretir.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dur_exe · dur_r1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;on_temizle&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dondur · tumu_temizle&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;getir_izin&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;en_getir_pc · en_F1F2 · en_F2D1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;en_D1D2 · en_D2R1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;en_R1R2 · en_R2E · en_EW&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;balon_F1F2 · balon_F2D1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;balon_D1D2 · balon_D2R1&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;balon_R1R2 · balon_R2E · balon_EW&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;on = ¬(dur_exe ∨ dur_r1 ∨ dondur)&lt;br&gt;en_getir_pc = en_F1F2 = en_F2D1 = en_D1D2 = en_D2R1 = on&lt;br&gt;en_R1R2 = en_R2E = ¬(dur_exe ∨ dondur)&lt;br&gt;en_EW   = ¬dondur&lt;br&gt;balon_F1F2 = on_temizle ∨ tumu_temizle ∨ ¬getir_izin&lt;br&gt;balon_F2D1 = balon_D1D2 = balon_D2R1&lt;br&gt;           = on_temizle ∨ tumu_temizle&lt;br&gt;balon_R1R2 = (dur_r1 ∧ ¬dur_exe) ∨ tumu_temizle&lt;br&gt;balon_R2E  = tumu_temizle&lt;br&gt;balon_EW   = dur_exe ∨ tumu_temizle&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="36" y="168" width="450" height="349.2" as="geometry"/></mxCell><mxCell id="c257" value="&lt;b style='font-size:13px'&gt;cla_gorev_denetci&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Hangi görevin ne zaman başlayıp biteceğine karar verir (mevcut modül, portları aynen).&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;bekleyen&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;8&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;softreset · hardreset&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;d2_gecerli&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;d2_mstop · d2_gecersiz&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;clk · rst_n&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;gorev_basla · gorev_no&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 3&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;gorev_bitti&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;pie_kesme&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;8&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;getir_izin · on_temizle&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;tumu_temizle · dondur&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;calisiyor · aktif_gorev&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 3&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;BOŞTA → (bekleyen ≠ 0) → HAKEM1 → HAKEM2&lt;br&gt;HAKEM2: bekleyen ≠ 0 ise gorev_basla = 1,&lt;br&gt;  gorev_no = en küçük numaralı bekleyen → CALIŞIYOR&lt;br&gt;CALIŞIYOR: getir_izin = 1&lt;br&gt;  d2_gecerli ∧ d2_mstop: gorev_bitti, pie_kesme,&lt;br&gt;    on_temizle → HAKEM1   (yeni F1 3 çevrim sonra)&lt;br&gt;  d2_gecerli ∧ d2_gecersiz: pie_kesme, dondur → DONDU&lt;br&gt;soft/hardreset: → BOŞTA, tumu_temizle&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#cdb6e6;strokeColor=#5b3f86;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="502" y="168" width="450" height="322" as="geometry"/></mxCell><mxCell id="c258" value="&lt;b style='font-size:13px'&gt;cla_ctrl_regs&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;CPU&amp;#x27;nun görev yazmaçları: bekleyen, taşma, izin ve çalışan görev.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;cpu_wr_en · cpu_reg_addr&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 3&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;cpu_wr_data&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;hw_task_trig&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;8&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;gorev_basla · gorev_no&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 3&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;gorev_bitti&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;clk · rst_n&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;cpu_rd_data&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;bekleyen&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;8&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mirun&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;8&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;softreset · hardreset&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;bekleyen = MIFR &amp;amp; MIER&lt;br&gt;CPU yazma: 2 MICLR: MIFR &amp;amp;= ~veri  3 MICLROVF: MIOVF &amp;amp;= ~veri&lt;br&gt;   4 MIFRC: MIFR |= veri   5 MIER = veri   7 MCTL: reset darbesi&lt;br&gt;hw_task_trig[i]: MIFR[i] kuruluysa MIOVF[i] = 1&lt;br&gt;                 değilse MIFR[i] = 1&lt;br&gt;gorev_basla: MIFR[no] = 0, MIRUN[no] = 1&lt;br&gt;gorev_bitti: MIRUN = 0&lt;br&gt;okuma: 0 MIFR, 1 MIOVF, 5 MIER, 6 MIRUN&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#c9a227;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="968" y="168" width="450" height="307" as="geometry"/></mxCell><mxCell id="c259" value="&lt;b style='font-size:13px'&gt;cla_mvect_regs&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Sekiz görevin başlangıç adresleri (mevcut modül).&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;cpu_wr_en · cpu_wr_task_id&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1 · 3&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;cpu_wr_data&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;active_task_id (= gorev_no)&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;3&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;clk · rst_n&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;cpu_rd_data&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;target_pc_out&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;cpu_wr_en: MVECT[cpu_wr_task_id] &amp;lt;= cpu_wr_data&lt;br&gt;cpu_rd_data   = MVECT[cpu_wr_task_id]&lt;br&gt;target_pc_out = MVECT[active_task_id]&lt;br&gt;mvect_pc = target_pc_out[11:0]&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#cdb6e6;strokeColor=#5b3f86;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="968" y="491" width="450" height="221.4" as="geometry"/></mxCell><mxCell id="c260" value="&lt;b style='font-size:13px'&gt;MPC · 12 FF&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;D2&amp;#x27;deki buyruğun adresi (izde görünen program sayacı).&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;gorev_basla · mvect_pc&lt;