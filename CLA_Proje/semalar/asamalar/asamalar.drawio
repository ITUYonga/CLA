<mxfile host="drawio" type="device"><diagram id="s0" name="F1 · getirme adresi"><mxGraphModel dx="1000" dy="1000" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1182" pageHeight="722" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b style='font-size:22px'&gt;Aşama F1: getirme adresi&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1400" height="32" as="geometry"/></mxCell><mxCell id="c12" value="&lt;span style='font-size:13px'&gt;Bu çevrimde getirilecek buyruğun adresi L3 program belleğine verilir ve bir sonraki çevrimin getirme adresi seçilir. Dallanma D2&amp;#x27;de karar verdiği için dal hedefi bir sonraki çevrimin F1&amp;#x27;ine yetişir; aradaki 3 buyruk gecikme yuvasıdır.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1400" height="46" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c14" value="&lt;span style='font-size:12px'&gt;boru hattı yazmacı (FF)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#cdb6e6;strokeColor=#5b3f86;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="225" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c16" value="&lt;span style='font-size:12px'&gt;mimari durum (FF)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="245" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="388" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c18" value="&lt;span style='font-size:12px'&gt;kombinasyonel blok&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="408" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c19" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="558" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c20" value="&lt;span style='font-size:12px'&gt;BRAM&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="578" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e9f5e4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="630" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c22" value="&lt;span style='font-size:12px'&gt;ALU&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="650" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c23" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#c9a227;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="695" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c24" value="&lt;span style='font-size:12px'&gt;önerilen arayüz (mevcut modülden farklı)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="715" y="95" width="300" height="20" as="geometry"/></mxCell><mxCell id="c25" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="1019" y="99" width="18" height="12" as="geometry"/></mxCell><mxCell id="c26" value="&lt;span style='font-size:12px'&gt;saat kenarı · &lt;b style='color:#2e7d32'&gt;▶ girdi&lt;/b&gt; · &lt;b style='color:#b71c1c'&gt;◀ çıktı&lt;/b&gt; · sağdaki sayı = bit&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1041" y="95" width="520" height="20" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b style='font-size:12.5px'&gt;Dışarıdan gelen sinyaller&lt;/b&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:3px'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;sinyal&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:0 12px'&gt;&lt;b&gt;bit&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;kaynak&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;getir_izin&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;görev denetçisi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;gorev_basla&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;görev denetçisi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;mvect_pc&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;td&gt;cla_mvect_regs.target_pc_out[11:0]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;dal_alindi&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;D2 · dal birimi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;dal_hedef&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;td&gt;D2 · dal birimi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;en_getir_pc, en_F1F2, balon_F1F2&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;1 · 1 · 1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;boru hattı denetimi&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="340" y="128" width="243" height="145.2" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style='font-size:12.5px'&gt;Dışarı giden sinyaller&lt;/b&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:3px'&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;sinyal&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:0 12px'&gt;&lt;b&gt;bit&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;hedef&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;l3_adr&lt;/td&gt;&lt;td style='padding:0 12px;text-align:right'&gt;&lt;b&gt;11&lt;/b&gt;&lt;/td&gt;&lt;td&gt;L3 program BRAM (F2), en_F1F2 ile kenarda içine alınır&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="599" y="128" width="243" height="67.2" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style='font-size:15px'&gt;F1 · getirme adresi&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#9e9e9e;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;spacingBottom=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="340" y="297.2" width="502" height="395.6" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b style='font-size:13px'&gt;Sonraki getirme adresi&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;L3&amp;#x27;e bu çevrimin adresini verir, getirme sayacının bir sonraki değerini seçer.&lt;/i&gt;&lt;/div&gt;&lt;table style='border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding-right:18px'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;getir_pc&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;getir_izin&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;gorev_basla&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;mvect_pc&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dal_alindi&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;dal_hedef&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style='vertical-align:top'&gt;&lt;table style='font-size:10.5px;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;l3_adr&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;11&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;f1_gecerli&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;f1_pc&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;sonraki_pc&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;l3_adr     = getir_pc[11:1]   // 32 bitlik satır&lt;br&gt;f1_pc      = getir_pc&lt;br&gt;f1_gecerli = getir_izin&lt;br&gt;sonraki_pc = gorev_basla ? mvect_pc&lt;br&gt;           : dal_alindi  ? dal_hedef&lt;br&gt;           : getir_izin  ? getir_pc + 2&lt;br&gt;           :               getir_pc&lt;br&gt;// 12 bit, taşma atılır; buyruk = 2 kelime&lt;br&gt;// öncelik: görev başı &amp;gt; dal &amp;gt; sıradaki&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c8c8c;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="356" y="337.2" width="470" height="335.6" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b style='font-size:13px'&gt;getir_pc · 12 FF&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;Getirme sayacı (MPC değil). F1&amp;#x27;deki buyruğun adresi.&lt;/i&gt;&lt;/div&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;sonraki_pc&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;en_getir_pc&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;clk · rst_n&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#b71c1c;padding-top:2px'&gt;&lt;b&gt;◀ çıktı&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-right:10px;'&gt;getir_pc&lt;/td&gt;&lt;td style='text-align:right;white-space:nowrap'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='font-size:10.5px;margin-top:6px'&gt;&lt;b&gt;Nasıl çalışır&lt;/b&gt;&lt;/div&gt;&lt;div style='font-family:Menlo,Consolas,monospace;font-size:10px;white-space:pre;margin-top:2px'&gt;saat kenarında:&lt;br&gt;  en_getir_pc ise&lt;br&gt;    getir_pc &amp;lt;= sonraki_pc&lt;br&gt;  değilse korunur&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#cdb6e6;strokeColor=#5b3f86;align=left;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;verticalAlign=top;spacingTop=6;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="297.2" width="290" height="395.6" as="geometry"/></mxCell><mxCell id="c32" value="" style="triangle;direction=north;html=1;fillColor=#5b3f86;strokeColor=#5b3f86;" vertex="1" parent="1"><mxGeometry x="156" y="679.8" width="18" height="12" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b style='font-size:13px'&gt;F1/F2 · 13 FF&lt;/b&gt;&lt;div style='font-size:10.5px;color:#333333;margin-top:2px'&gt;&lt;i&gt;F2&amp;#x27;deki buyruğun adresi ve geçerliliği. L3 BRAM&amp;#x27;in adres yazmacı da bu kenardadır.&lt;/i&gt;&lt;/div&gt;&lt;table style='font-size:10.5px;border-collapse:collapse;margin-top:4px'&gt;&lt;tr&gt;&lt;td colspan='2' style='color:#2e7d32;padding-top:2px'&gt;&lt;b&gt;▶ girdi&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding-righ