=1;html=1;strokeColor=#4d4d4d;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="310" y="566.2" as="sourcePoint"/><mxPoint x="340" y="566.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c88" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#4d4d4d;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="852" y="566.2" as="sourcePoint"/><mxPoint x="882" y="566.2" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="s3" name="D2 · kontrol, adres, dal"><mxGraphModel dx="1000" dy="1000" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1628" pageHeight="1049" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c89" value="&lt;b style='font-size:22px'&gt;Aşama D2: kontrol paketi, etkin adres, MAR artışı ve dal kararı&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1400" height="32" as="geometry"/></mxCell><mxCell id="c90" value="&lt;span style='font-size:13px'&gt;Kontrol paketi üretilir, bellek adresi hesaplanır, MAR artırılır, dal kararı verilir; MSTOP ve geçersiz kod görev denetçisine bildirilir. MAR, RPC ve dal güncellemeleri yalnız D2 ilerlerken (d2_ilerle) yapılır; beklemede hiçbiri olmaz.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1400" height="46" as="geometry"/></mxCell><mxCell id="c91" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7b5aa6;align=center;verticalAlign=middle;spacing=6;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="98" width="14" height="14" as="geometry"/></mxCell><mxCell id="c92" value="&lt;span style='font-size:12px'&gt;boru hattı yazmacı (FF)&lt;/span&gt;" style="text;ht