; ALU'yu butun birimleriyle CLA uzerinden kullanan kabul testi (TRM ornekleri temelli).
; Sonuclar CLA->CPU mesaj RAM'ine (0x1480..) yazilir; FPGA ayni bolgeyi dokup karsilastirir.
;#sembol _X    0x8800
;#sembol _len  0x8840
;#sembol _M1   0x8842
;#sembol _B1   0x8844
;#sembol _IQ   0x8846
;#veri16 0x8840 0x0007
;#veri   0x8800 0x40600000
;#veri   0x8802 0xBFA00000
;#veri   0x8804 0x41880000
;#veri   0x8806 0x40000000
;#veri   0x8808 0x41840000
;#veri   0x880A 0xC1F00000
;#veri   0x880C 0x411C0000
;#veri   0x8842 0x3FC00000
;#veri   0x8844 0x3E800000
;#veri   0x8846 0x02800000
GOREV1:
 MMOVI16 MAR1, #0x8800
 MUI16TOF32 MR0, @_len
 MNOP
 MNOP
 MMOV32 MR1, *MAR1[2]++
DONGU:
 MMOV32 MR2, *MAR1[2]++
 MMAXF32 MR1, MR2
 MADDF32 MR0, MR0, #-1.0
 MCMPF32 MR0, #1.0
 MNOP
 MNOP
 MNOP
 MBCNDD DONGU, NEQ
 MMOV32 @0x1480, MR1
 MNOP
 MNOP
 MMOV32 MR0, @_M1
 MMOV32 MR1, @0x8800
 MMPYF32 MR1, MR1, MR0
 || MMOV32 MR0, @_B1
 MADDF32 MR1, MR1, MR0
 MMOV32 @0x1482, MR1
 MEINVF32 MR2, MR1
 MMPYF32 MR3, MR2, MR1
 MSUBF32 MR3, #2.0, MR3
 MMPYF32 MR2, MR2, MR3
 MMOV32 @0x1484, MR2
 MI32TOF32 MR0, @_IQ
 MMPYF32 MR0, MR0, #0x3380
 MF32TOI16R MR1, MR0
 MFRACF32 MR2, MR0
 MMOV32 @0x1486, MR1
 MMOV32 @0x1488, MR2
 MMOVIZ MR3, #-6.0
 MCMPF32 MR3, #0.0
 MNEGF32 MR3, MR3, LT
 MABSF32 MR2, MR3
 MMOV32 @0x148A, MR3
 MMOVIZ MR0, #0x5555
 MMOVXI MR0, #0xAAAA
 MMOVIZ MR1, #0x5432
 MMOVXI MR1, #0xFEDC
 MXOR32 MR2, MR1, MR0
 MASR32 MR2, #3
 MMOV32 @0x148C, MR2
 MMACF32 MR3, MR2, MR3, MR0, MR1
 || MMOV32 MR2, @_M1
 MMOV32 @0x148E, MR3
 MMOV32 @0x1490, MSTF
 MSTOP
