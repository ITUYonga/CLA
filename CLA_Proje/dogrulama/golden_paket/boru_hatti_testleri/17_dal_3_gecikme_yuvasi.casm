; 17_dal_3_gecikme_yuvasi
; MBCNDD UNC: arkasindaki 3 komut her zaman calisir, 4.'su atlanir.
; Uretim: python3.11 ../golden_beklenen.py 17_dal_3_gecikme_yuvasi.casm -o beklenen --golden <CLA_GoldenModel>
 MMOVIZ MR0, #0.0
 MNOP
 MNOP
 MNOP
 MBCNDD HEDEF, UNC
 MMOVIZ MR1, #1.0
 MMOVIZ MR2, #2.0
 MMOVIZ MR3, #3.0
 MMOVIZ MR0, #4.0
 MNOP
HEDEF:
 MSTOP
 MNOP
 MNOP
 MNOP
