; 10_dur_r1_ayni_blok
; L1'e yaz, 3 sonra L1'in BASKA adresinden oku: 1 cevrim dur_r1 (19 cevrim).
; Uretim: python3.11 ../golden_beklenen.py 10_dur_r1_ayni_blok.casm -o beklenen --golden <CLA_GoldenModel>
;#veri 0x8810 0x40A00000
 MMOVIZ MR0, #2.0
 MNOP
 MNOP
 MNOP
 MMOV32 @0x8800, MR0
 MNOP
 MNOP
 MMOV32 MR1, @0x8810
 MNOP
 MNOP
 MNOP
 MSTOP
 MNOP
 MNOP
 MNOP
