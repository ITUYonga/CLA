; 23_kosullu_yukleme_mar_artar
; Kosul tutmayan MMOV32 MR0, *MAR0[2]++, EQ: MR0 yuklenmez ama MAR0 yine artar (8810 -> 8812); artis D2'de, kosuldan bagimsiz.
; Uretim: python3.11 ../golden_beklenen.py 23_kosullu_yukleme_mar_artar.casm -o beklenen --golden <CLA_GoldenModel>
;#veri 0x8810 0x40A00000
 MMOVI16 MAR0, #0x8810
 MMOVIZ MR1, #1.0
 MNOP
 MNOP
 MCMPF32 MR1, #2.0
 MNOP
 MNOP
 MNOP
 MMOV32 MR0, *MAR0[2]++, EQ
 MNOP
 MNOP
 MNOP
 MSTOP
 MNOP
 MNOP
 MNOP
