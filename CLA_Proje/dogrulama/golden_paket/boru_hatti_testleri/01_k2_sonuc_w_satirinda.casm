; 01_k2_sonuc_w_satirinda
; FP sonucu W'nin sonunda yazilir (K2): MMPYF32'nin EXE satirinda MR0 eski, bir sonraki (W) satirda 6.0.
; Uretim: python3.11 ../golden_beklenen.py 01_k2_sonuc_w_satirinda.casm -o beklenen --golden <CLA_GoldenModel>
 MMOVIZ MR1, #2.0
 MMOVIZ MR2, #3.0
 MNOP
 MNOP
 MNOP
 MMPYF32 MR0, MR1, MR2
 MNOP
 MNOP
 MNOP
 MSTOP
 MNOP
 MNOP
 MNOP
