; 15_d2_mar_bir_kez
; dur_r1 sirasinda D2'de *MAR0[2]++: MAR0 bir kez artar (8810 -> 8812), ilerledigi cevrimde.
; Uretim: python3.11 ../golden_beklenen.py 15_d2_mar_bir_kez.casm -o beklenen --golden <CLA_GoldenModel>
;#veri 0x8810 0x40A00000
;#veri 0x8812 0x40C00000
 MMOVIZ MR0, #2.0
 MMOVI16 MAR0, #0x8810
 MNOP
 MNOP
 MNOP
 MMOV32 @0x8800, MR0
 MNOP
 MNOP
 MMOV32 MR1, @0x8820
 MMOV32 MR2, *MAR0[2]++
 MNOP
 MNOP
 MNOP
 MSTOP
 MNOP
 MNOP
 MNOP
