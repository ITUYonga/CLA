; 19_yaz_oku_eski_deger
; Yazdiktan 2 komut sonra ayni adresi okumak ESKI degeri verir (Tablo 10-1). --zorla gerekir (lint HATA).
; Uretim: python3.11 ../golden_beklenen.py 19_yaz_oku_eski_deger.casm -o beklenen --golden <CLA_GoldenModel> --zorla
;#veri 0x8800 0x11111111
 MMOVIZ MR0, #2.0
 MNOP
 MNOP
 MNOP
 MMOV32 @0x8800, MR0
 MNOP
 MMOV32 MR1, @0x8800
 MNOP
 MNOP
 MNOP
 MSTOP
 MNOP
 MNOP
 MNOP
