; 06_k2_msetflg_kazanir
; Tasan carpimdan hemen sonra MSETFLG LVF=0: son LVF = 0 (EXE bayrakta da kazanir).
; Uretim: python3.11 ../golden_beklenen.py 06_k2_msetflg_kazanir.casm -o beklenen --golden <CLA_GoldenModel>
 MMOVIZ MR1, #0x7F00
 MNOP
 MNOP
 MNOP
 MMPYF32 MR0, MR1, MR1
 MSETFLG LVF=0
 MNOP
 MNOP
 MNOP
 MSTOP
 MNOP
 MNOP
 MNOP
