; 13_dur_r1_mesaj_ram
; CLA->CPU mesaj RAM'ine yaz / CPU->CLA'dan oku: durma yok; CLA->CPU'dan oku: durma var (26 cevrim).
; Uretim: python3.11 ../golden_beklenen.py 13_dur_r1_mesaj_ram.casm -o beklenen --golden <CLA_GoldenModel>
;#veri 0x1500 0x40A00000
 MMOVIZ MR0, #2.0
 MNOP
 MNOP
 MNOP
 MMOV32 @0x1480, MR0
 MNOP
 MNOP
 MMOV32 MR1, @0x1500
 MNOP
 MNOP
 MNOP
 MMOV32 @0x1482, MR0
 MNOP
 MNOP
 MMOV32 MR2, @0x14A0
 MNOP
 MNOP
 MNOP
 MSTOP
 MNOP
 MNOP
 MNOP
