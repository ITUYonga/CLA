; 14_dur_r1_16_bit
; MMOV16 ile L2'ye yaz, MMOVZ16 ile L2'den oku: 1 cevrim dur_r1 (19 cevrim).
; Uretim: python3.11 ../golden_beklenen.py 14_dur_r1_16_bit.casm -o beklenen --golden <CLA_GoldenModel>
;#veri 0x8C10 0x40A00000
 MMOVIZ MR0, #2.0
 MNOP
 MNOP
 MNOP
 MMOV16 @0x8C00, MR0
 MNOP
 MNOP
 MMOVZ16 MR1, @0x8C10
 MNOP
 MNOP
 MNOP
 MSTOP
 MNOP
 MNOP
 MNOP
