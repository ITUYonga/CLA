;#veri 0x8C10 0x40A00000
 MMOVIZ MR0, #2.0
 MNOP
 MNOP
 MNOP
 MMOV32 @0x8800, MR0
 MNOP
 MNOP
 MMOV32 MR1, @0x8C10
 MNOP
 MNOP
 MNOP
 MSTOP
 MNOP
 MNOP
 MNOP
