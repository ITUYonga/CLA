; 09_dur_exe_yazan_beklemez
; Yalniz yazan MMOV32 MR0 beklemez; MR3'u okuyan saklama bekler (20 cevrim).
; Uretim: python3.11 ../golden_beklenen.py 09_dur_exe_yazan_beklemez.casm -o beklenen --golden <CLA_GoldenModel>
;#veri 0x8800 0x40A00000
 MMOVIZ MR1, #2.0
 MMOVIZ MR2, #3.0
 MNOP
 MNOP
 MNOP
 MMPYF32 MR0, MR1, MR2
 MMOV32 MR0, @0x8800
 MMPYF32 MR3, MR1, MR2
 MMOV32 @0x8802, MR3
 MNOP
 MNOP
 MNOP
 MSTOP
 MNOP
 MNOP
 MNOP
