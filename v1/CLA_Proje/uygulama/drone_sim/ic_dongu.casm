; =====================================================================
;  ic_dongu.casm - CLA gorev 1: ic dongu (aci PD + itki + motor dagitimi)
; ---------------------------------------------------------------------
;  Is bolumu (paket.IC):
;    CPU (simulasyon)  dis dongu, 50 Hz : konum PID -> th_d, TV = m (g + a_y)
;    CLA (bu program)  ic dongu, 500 Hz : her adimda olculen aciyla
;
;    T   = TV / cos(th)           cos polinomla, bolme MEINVF32 + 2 Newton
;    dF  = KTAU (KPT (th_d - th) - KDT w)          KTAU = I / (2L)
;    F_R = T/2 + dF,  F_L = T/2 - dF,  [0, FMAX]
;
;  Dal yok: sure girdiden bagimsiz (her adim ayni cevrim).
;  Kullanilan ALU birimleri: FP carpma/toplama (K1/K2), kestirim
;  (MEINVF32), karsilastirma (MMINF32/MMAXF32).
; =====================================================================

; ---------------- 1) T = TV / cos(th) ---------------------------------
 MMOV32 MR0, @_TH
 MMPYF32 MR1, MR0, MR0          ; th^2
 MMOV32 MR2, @_C24
 MMPYF32 MR2, MR2, MR1          ; th^2/24
 MADDF32 MR2, #-0.5, MR2        ; th^2/24 - 1/2
 MMPYF32 MR2, MR2, MR1
 MADDF32 MR2, #1.0, MR2         ; cos(th) ~ 1 - th^2/2 + th^4/24
 MMOV32 MR3, @_CMIN
 MMAXF32 MR2, MR3               ; cos >= CMIN
 MEINVF32 MR3, MR2              ; r ~ 1/cos (8 bit)
 MMPYF32 MR1, MR2, MR3
 MSUBF32 MR1, #2.0, MR1
 MMPYF32 MR3, MR3, MR1          ; Newton 1
 MMPYF32 MR1, MR2, MR3
 MSUBF32 MR1, #2.0, MR1
 MMPYF32 MR3, MR3, MR1          ; Newton 2: MR3 = 1/cos
 MMOV32 MR1, @_TV
 MMPYF32 MR1, MR1, MR3          ; T
 MMOV32 @_T, MR1
 MMPYF32 MR1, #0.5, MR1         ; MR1 = T/2 (motorlara kadar korunur)

; ---------------- 2) aci PD: dF ----------------------------------------
 MMOV32 MR0, @_THD
 MMOV32 MR2, @_TH
 MSUBF32 MR0, MR0, MR2          ; e_th = th_d - th
 MMOV32 MR2, @_KPT
 MMPYF32 MR0, MR0, MR2          ; Kpt * e_th
 MMOV32 MR2, @_W
 MMOV32 MR3, @_KDT
 MMPYF32 MR2, MR2, MR3          ; Kdt * w
 MSUBF32 MR0, MR0, MR2          ; istenen aci ivmesi
 MMOV32 MR2, @_KTAU
 MMPYF32 MR0, MR0, MR2          ; dF = (F_R - F_L) / 2

; ---------------- 3) motorlar ------------------------------------------
 MADDF32 MR2, MR1, MR0          ; F_R
 MSUBF32 MR3, MR1, MR0          ; F_L
 MMOV32 MR1, @_FMAX
 MMINF32 MR2, MR1
 MMINF32 MR3, MR1
 MMOVIZ MR1, #0.0
 MMAXF32 MR2, MR1
 MMAXF32 MR3, MR1
 MMOV32 @_FR, MR2
 MMOV32 @_FL, MR3
 MSTOP
 MNOP
 MNOP
 MNOP
