; =====================================================================
;  ic_kestirim.casm - CLA gorev 1: aci kestirimi + ic dongu (paket.ICK)
; ---------------------------------------------------------------------
;  Her ic adimda (500 Hz) ham IMU ile:
;   1) tahmin     tp  = KORU * th + gx * DT                 (jiroskop)
;   2) yercekimi  g_b = f - R(-tp) a_w                      (ivmeolcer - CPU'nun olctugu ivme)
;   3) olcum      th_i = atan(g_bx / g_bz)                  (A&S 4.4.47, |u| <= UMAX)
;   4) birlestir  th  = tp + KK (th_i - tp)                 (tamamlayici suzgec, KK = DT/tau)
;   5) ic dongu   T = TV / cos(th),  dF = KTAU (KPT (th_d - th) - KDT gx),
;                 F_R = T/2 + dF, F_L = T/2 - dF, [0, FMAX]
;  th adimlar arasi L1'de (_THK). KORU = 0: kestirim sifirlanir (R tusu).
;  Dal yok: sure girdiden bagimsiz. Python aynasi: sensor.kestirim_yasa + cpu_dongu.ic_yasa
; =====================================================================

; ---------------- 1) tahmin: tp = KORU * th + gx * DT -----------------
 MMOV32 MR0, @_THK
 MMOV32 MR1, @_KORU
 MMPYF32 MR0, MR0, MR1          ; KORU = 0 -> sifirla
 MMOV32 MR1, @_GX
 MMOV32 MR2, @_DT
 MMPYF32 MR1, MR1, MR2          ; gx * DT
 MADDF32 MR0, MR0, MR1          ; tp
 MMOV32 @_S0, MR0               ; S0 = tp

; ---------------- 2a) cos(tp), sin(tp) -----------------------------------
 MMPYF32 MR1, MR0, MR0          ; tp^2
 MMOV32 MR2, @_C24
 MMPYF32 MR2, MR2, MR1
 MADDF32 MR2, #-0.5, MR2
 MMPYF32 MR2, MR2, MR1
 MADDF32 MR2, #1.0, MR2         ; c = 1 - t^2/2 + t^4/24
 MMOV32 @_S1, MR2               ; S1 = c
 MMOV32 MR3, @_C120
 MMPYF32 MR3, MR3, MR1          ; t^2/120
 MMOV32 MR2, @_C6
 MSUBF32 MR3, MR3, MR2          ; t^2/120 - 1/6
 MMPYF32 MR3, MR3, MR1
 MADDF32 MR3, #1.0, MR3
 MMPYF32 MR3, MR3, MR0          ; s = t - t^3/6 + t^5/120
 MMOV32 @_S2, MR3               ; S2 = s

; ---------------- 2b) g_b = f - R(-tp) a_w --------------------------------
 MMOV32 MR0, @_AXW
 MMOV32 MR1, @_AYW
 MMOV32 MR2, @_S1               ; c
 MMPYF32 MR2, MR0, MR2          ; ax c
 MMPYF32 MR3, MR1, MR3          ; ay s
 MADDF32 MR2, MR2, MR3          ; ax c + ay s
 MMOV32 MR3, @_FX
 MSUBF32 MR3, MR3, MR2          ; g_bx
 MMOV32 @_S3, MR3               ; S3 = g_bx
 MMOV32 MR2, @_S2               ; s
 MMPYF32 MR0, MR0, MR2          ; ax s
 MMOV32 MR2, @_S1               ; c
 MMPYF32 MR1, MR1, MR2          ; ay c
 MSUBF32 MR1, MR1, MR0          ; -ax s + ay c
 MMOV32 MR0, @_FZ
 MSUBF32 MR0, MR0, MR1          ; g_bz
 MMOV32 MR1, @_FZMIN
 MMAXF32 MR0, MR1               ; g_bz >= FZMIN

; ---------------- 3) th_i = atan(g_bx / g_bz) ----------------------------
 MEINVF32 MR1, MR0              ; r ~ 1/g_bz
 MMPYF32 MR2, MR0, MR1
 MSUBF32 MR2, #2.0, MR2
 MMPYF32 MR1, MR1, MR2          ; Newton 1
 MMPYF32 MR2, MR0, MR1
 MSUBF32 MR2, #2.0, MR2
 MMPYF32 MR1, MR1, MR2          ; Newton 2: 1/g_bz
 MMOV32 MR0, @_S3
 MMPYF32 MR0, MR0, MR1          ; u
 MMOV32 MR1, @_UMAX
 MMINF32 MR0, MR1
 MNEGF32 MR1, MR1
 MMAXF32 MR0, MR1               ; u in [-UMAX, UMAX]
 MMPYF32 MR1, MR0, MR0          ; u^2
 MMOV32 MR2, @_A9
 MMPYF32 MR2, MR2, MR1
 MMOV32 MR3, @_A7
 MADDF32 MR2, MR2, MR3
 MMPYF32 MR2, MR2, MR1
 MMOV32 MR3, @_A5
 MADDF32 MR2, MR2, MR3
 MMPYF32 MR2, MR2, MR1
 MMOV32 MR3, @_A3
 MADDF32 MR2, MR2, MR3
 MMPYF32 MR2, MR2, MR1
 MMOV32 MR3, @_A1
 MADDF32 MR2, MR2, MR3
 MMPYF32 MR0, MR0, MR2          ; th_i

; ---------------- 4) th = tp + KK (th_i - tp) -----------------------------
 MMOV32 MR1, @_S0               ; tp
 MSUBF32 MR0, MR0, MR1
 MMOV32 MR2, @_KK
 MMPYF32 MR0, MR0, MR2
 MADDF32 MR0, MR1, MR0          ; th
 MMOV32 @_THK, MR0              ; L1: sonraki adima
 MMOV32 @_OTHK, MR0             ; C2M: CPU'ya (telemetri)

; ---------------- 5a) T = TV / cos(th) ------------------------------------
 MMPYF32 MR1, MR0, MR0          ; th^2
 MMOV32 MR2, @_C24
 MMPYF32 MR2, MR2, MR1
 MADDF32 MR2, #-0.5, MR2
 MMPYF32 MR2, MR2, MR1
 MADDF32 MR2, #1.0, MR2         ; cos(th)
 MMOV32 MR3, @_CMIN
 MMAXF32 MR2, MR3               ; cos >= CMIN
 MEINVF32 MR3, MR2
 MMPYF32 MR1, MR2, MR3
 MSUBF32 MR1, #2.0, MR1
 MMPYF32 MR3, MR3, MR1          ; Newton 1
 MMPYF32 MR1, MR2, MR3
 MSUBF32 MR1, #2.0, MR1
 MMPYF32 MR3, MR3, MR1          ; Newton 2: 1/cos
 MMOV32 MR1, @_TV
 MMPYF32 MR1, MR1, MR3          ; T
 MMOV32 @_T, MR1
 MMPYF32 MR1, #0.5, MR1         ; MR1 = T/2

; ---------------- 5b) aci PD (kestirilen aci, jiroskop) -------------------
 MMOV32 MR0, @_THD
 MMOV32 MR2, @_THK
 MSUBF32 MR0, MR0, MR2          ; th_d - th
 MMOV32 MR2, @_KPT
 MMPYF32 MR0, MR0, MR2
 MMOV32 MR2, @_GX
 MMOV32 MR3, @_KDT
 MMPYF32 MR2, MR2, MR3          ; Kdt * gx
 MSUBF32 MR0, MR0, MR2
 MMOV32 MR2, @_KTAU
 MMPYF32 MR0, MR0, MR2          ; dF

; ---------------- 5c) motorlar --------------------------------------------
 MADDF32 MR2, MR1, MR0          ; F_R
 MSUBF32 MR3, MR1, MR0          ; F_L
 MMOV32 MR1, @_FMAX
 MMINF32 MR2, MR1
 MMINF32 MR3, MR1
 MMOVIZ MR1, #0.0
 MMAXF32 MR2, MR1
 MMAXF32 MR3, MR1
 MMOV32 @_FR, MR2
 MMOV32 @_FL, MR3
 MSTOP
 MNOP
 MNOP
 MNOP
